/* Julep Call Authentication, one round after an injected agreed pairing state.
 * Unbounded participants/sessions; public enrollment tokens and delegation
 * signatures. A delegation token's owner identity reaches the network only
 * through Reveal_Dtk (delegate compromise) or a call message.
 * Ideal randomized AMF verification relation includes sender and receiver forgery.
 * See ABSTRACTIONS.md for primitive assumptions and composition limits.
 * no_precomp and heuristic annotations change search order, never traces.
 */
theory JulepAuth
begin

heuristic: S

builtins: hashing, asymmetric-encryption, diffie-hellman, symmetric-encryption

functions: sign/2, kdf/1, aead/4, aead_open/3, aead_nonce/1

equations: aead_open(aead(m,k,r,ad),k,ad) = m,
           aead_nonce(aead(m,k,r,ad)) = r

restriction OnlyOnce: "All x #i #j. OnlyOnce(x) @i & OnlyOnce(x) @j ==> #i = #j"

rule ES_Init:
  [ Fr(~skES) ] --[ OnlyOnce('ES') ]-> [ !ES(~skES), Out(pk(~skES)) ]

rule Au_Init:
  [ Fr(~skAu) ] --[ OnlyOnce('Au') ]-> [ !Au(pk(~skAu)), Out(pk(~skAu)) ]

rule Enroll:
  let ipk  = <pk(~ska), pk(~skb), pk(~skc)>
      hid  = h(<'hid', ~id, ipk>)
      esig = sign(<'etk', $tn, ipk, 'ex', hid>, ~skES)
      etk  = <$tn, ipk, 'ex', hid, esig>
  in
  [ !ES(~skES)[no_precomp], Fr(~ska), Fr(~skb), Fr(~skc), Fr(~id) ]
  --[ Enrolled($tn, ipk, ~id), AmfKey(ipk, ~ska), DlgKey(ipk, ~skb) ]->
  [ !Ltk($tn, ipk, ~ska, ~skb, ~skc), !Etk($tn, ipk, ~id, etk), !Token($tn, ipk, hid, esig), Out(etk) ]

rule Delegate:
  let ipkO = <pk(~skaO), pk(~skbO), pk(~skcO)>
      dsig = sign(<'dlg', ipkD, 'exD', $src, 'orig'>, ~skbO)
      dtk  = <~idO, etkO, 'exD', ipkD, dsig>
  in
  [ !Ltk($src, ipkO, ~skaO, ~skbO, ~skcO)[no_precomp], !Etk($src, ipkO, ~idO, etkO)[no_precomp],
    !Etk($tnD, ipkD, ~idD, etkD)[no_precomp] ]
  --[ Delegated($src, ipkO, ipkD) ]->
  [ !Dtk($src, ipkO, ipkD, dtk), Out(<etkO, 'exD', ipkD, dsig>) ]

rule Reveal_Ltk:
  [ !Ltk($tn, ipk, ~ska, ~skb, ~skc)[no_precomp] ]
  --[ Reveal(ipk) ]->
  [ Out(<~ska, ~skb, ~skc>) ]

rule Reveal_Device_Id:
  [ !Etk($tn, ipk, ~id, etk)[no_precomp] ]
  --[ RevealId(ipk) ]->
  [ Out(~id) ]

// A compromised delegate device discloses the delegation token it holds,
// including the owner's identity, which the owner disclosed to the delegate.
rule Reveal_Dtk:
  [ !Dtk($src, ipkO, ipkD, dtk)[no_precomp] ]
  --[ RevealDtk(ipkO, ipkD) ]->
  [ Out(dtk) ]

rule Adversary_Frank:
  [ In(<m, sk, ipkR, pkAu>)[no_precomp], Fr(~sig) ]
  --> [ !Amf(~sig, m, pk(sk), ipkR, pkAu), Out(~sig) ]

rule Adversary_Receiver_Forge:
  [ In(<m, vkaS, skR, vkbR, pkcR, pkAu>)[no_precomp], Fr(~sig) ]
  --> [ !Amf(~sig, m, vkaS, <pk(skR), vkbR, pkcR>, pkAu), Out(~sig) ]

rule Setup_State_direct:
  [ !Etk($src, ipkA, ~idA, etkA)[no_precomp], !Etk($dst, ipkB, ~idB, etkB)[no_precomp], Fr(~K) ]
  --[ SetupState(~K, $src, $dst, ipkA, ipkB) ]->
  [ StA($src, $dst, ipkA, ipkB, ~K), StB($dst, $src, ipkB, ipkA, ~K), !SharedK(~K) ]

rule Setup_State_delegated:
  [ !Dtk($src, ipkO, ipkD, dtk)[no_precomp], !Etk($dst, ipkB, ~idB, etkB)[no_precomp], Fr(~K) ]
  --[ SetupState(~K, $src, $dst, ipkD, ipkB) ]->
  [ StA($src, $dst, ipkD, ipkB, ~K), StB($dst, $src, ipkB, ipkD, ~K), !SharedK(~K) ]

rule Reveal_State:
  [ !SharedK(~K)[no_precomp] ] --[ RevealState(~K) ]-> [ Out(~K) ]

rule CA_A1_direct:
  let cdt  = <$src, $dst, $ts>
      idx  = h(<'idxca', ~K, cdt>)
      A    = 'g'^~a
      etkA = <$src, ipkA, 'ex', hidA, esigA>
      mA   = <'1', h(<'ratchet-context', ~K, idx>), cdt, $ts, A, $ccx, 'nodlg', etkA, ~idA>
      ctxA = aead(<mA, ~sigA>, ~K, ~rhoA, <idx, '1', 'caller'>)
  in
  [ StA($src, $dst, ipkA, ipkB, ~K)[no_precomp], !Etk($src, ipkA, ~idA, etkA)[no_precomp],
    !Ltk($src, ipkA, ~ska, ~skb, ~skc)[no_precomp], !Au(pkAu)[no_precomp], Fr(~a), Fr(~sigA), Fr(~rhoA) ]
  --[ IdentitySent('caller', ipkA, ~idA, ~K), FrankedRequest($src, $dst, $ts, ipkA, ipkB, mA), DhExp(~a),
      Franked(mA, ~ska, ipkB, pkAu) ]->
  [ StA1($src, $dst, $ts, ipkA, ipkB, ~K, ~a, idx, ctxA, mA, ~sigA), !Amf(~sigA, mA, pk(~ska), ipkB, pkAu), Out(<idx, ctxA>) ]

rule CA_A1_delegated:
  let cdt  = <$src, $dst, $ts>
      idx  = h(<'idxca', ~K, cdt>)
      A    = 'g'^~a
      dtk  = <~idO, etkO, 'exD', ipkD, dsig>
      mA   = <'1', h(<'ratchet-context', ~K, idx>), cdt, $ts, A, $ccx, dtk>
      ctxA = aead(<mA, ~sigA>, ~K, ~rhoA, <idx, '1', 'caller'>)
  in
  [ StA($src, $dst, ipkD, ipkB, ~K)[no_precomp], !Dtk($src, ipkO, ipkD, dtk)[no_precomp], !Etk($src, ipkO, ~idO, etkO)[no_precomp],
    !Ltk($tnD, ipkD, ~skaD, ~skbD, ~skcD)[no_precomp], !Au(pkAu)[no_precomp], Fr(~a), Fr(~sigA), Fr(~rhoA) ]
  --[ IdentitySent('caller', ipkO, ~idO, ~K), FrankedRequest($src, $dst, $ts, ipkD, ipkB, mA), DhExp(~a),
      Franked(mA, ~skaD, ipkB, pkAu),
      FrankedRequestDelegated($src, $dst, ipkO, ipkD) ]->
  [ StA1($src, $dst, $ts, ipkD, ipkB, ~K, ~a, idx, ctxA, mA, ~sigA), !Amf(~sigA, mA, pk(~skaD), ipkB, pkAu), Out(<idx, ctxA>) ]

rule CA_B_verify_direct:
  let cdt  = <$src, $dst, $ts>
      idx  = h(<'idxca', ~K, cdt>)
      ipkA = <pk(skaA), vkbA, pkcA>
      hidA = h(<'hid', idA, ipkA>)
      etkA = <$src, ipkA, 'ex', hidA, esigA>
      mA   = <'1', h(<'ratchet-context', ~K, idx>), cdt, $ts, A, ccx, 'nodlg', etkA, idA>
      ctxA = aead(<mA, sigA>, ~K, rhoA, <idx, '1', 'caller'>)
  in
  [ StB($dst, $src, ipkB, ipkA, ~K)[no_precomp], !Token($src, ipkA, hidA, esigA)[no_precomp], !Au(pkAu)[no_precomp], !Amf(sigA, mA, pk(skaA), ipkB, pkAu)[no_precomp], In(<idx, ctxA>)[no_precomp] ]
  --[ DisplayCaller($dst, $src, $ts, idA, ipkA, ipkB, mA) ]->
  [ StB3($dst, $src, $ts, ipkB, ipkA, ~K, idx, ctxA, mA, sigA, A) ]

rule CA_B_verify_delegated:
  let cdt  = <$src, $dst, $ts>
      idx  = h(<'idxca', ~K, cdt>)
      ipkD = <pk(skaD), vkbD, pkcD>
      ipkO = <vkaO, pk(skbO), pkcO>
      hidO = h(<'hid', idO, ipkO>)
      etkO = <$src, ipkO, 'ex', hidO, esigO>
      dsig = sign(<'dlg', ipkD, 'exD', $src, 'orig'>, skbO)
      dtk  = <idO, etkO, 'exD', ipkD, dsig>
      mA   = <'1', h(<'ratchet-context', ~K, idx>), cdt, $ts, A, ccx, dtk>
      ctxA = aead(<mA, sigA>, ~K, rhoA, <idx, '1', 'caller'>)
  in
  [ StB($dst, $src, ipkB, ipkD, ~K)[no_precomp], !Token($src, ipkO, hidO, esigO)[no_precomp], !Au(pkAu)[no_precomp], !Amf(sigA, mA, pk(skaD), ipkB, pkAu)[no_precomp], In(<idx, ctxA>)[no_precomp] ]
  --[ DisplayCaller($dst, $src, $ts, idO, ipkD, ipkB, mA),
      AcceptedDelegation($dst, $src, ipkO, ipkD) ]->
  [ StB3($dst, $src, $ts, ipkB, ipkD, ~K, idx, ctxA, mA, sigA, A) ]

rule CA_B_answer:
  let B     = 'g'^~b
      nce   = h(<'nce', mA, sigA>)
      etkB  = <$dst, ipkB, 'ex', hidB, esigB>
      mB    = <'2', nce, B, etkB, ~idB>
      ctxB  = aead(<mB, ~sigB>, ~K, ~rhoB, <idx, '2', 'recipient'>)
      Knext = kdf(<~K, idx, mA, sigA, mB, ~sigB, A^~b>)
  in
  [ StB3($dst, $src, $ts, ipkB, ipkAstar, ~K, idx, ctxA, mA, sigA, A)[no_precomp],
    !Etk($dst, ipkB, ~idB, etkB)[no_precomp], !Ltk($dst, ipkB, ~skaB, ~skbB, ~skcB)[no_precomp],
    !Au(pkAu)[no_precomp], Fr(~b), Fr(~sigB), Fr(~rhoB) ]
  --[ IdentitySent('recipient', ipkB, ~idB, ~K), Answered($dst, $src, ipkB, ipkAstar, nce, mB), DhExp(~b),
      Franked(mB, ~skaB, ipkAstar, pkAu),
      PersistB($dst, $src, ipkB, ipkAstar, ~K, Knext) ]->
  [ StB4($dst, $src, ipkB, ipkAstar, Knext), !Amf(~sigB, mB, pk(~skaB), ipkAstar, pkAu), Out(<idx, ctxB>) ]

rule CA_A2:
  let idx   = h(<'idxca', ~K, <$src, $dst, $ts>>)
      nce   = h(<'nce', mA, sigA>)
      ipkB  = <pk(skaB), vkbB, pkcB>
      hidB  = h(<'hid', idB, ipkB>)
      etkB  = <$dst, ipkB, 'ex', hidB, esigB>
      mB    = <'2', nce, B, etkB, idB>
      ctxB  = aead(<mB, sigB>, ~K, rhoB, <idx, '2', 'recipient'>)
      Knext = kdf(<~K, idx, mA, sigA, mB, sigB, B^~a>)
  in
  [ StA1($src, $dst, $ts, ipkA, ipkB, ~K, ~a, idx, ctxA, mA, sigA)[no_precomp],
    !Token($dst, ipkB, hidB, esigB)[no_precomp], !Au(pkAu)[no_precomp], !Amf(sigB, mB, pk(skaB), ipkA, pkAu)[no_precomp], In(<idx, ctxB>)[no_precomp] ]
  --[ DisplayRecipient($src, $dst, idB, ipkB, ipkA, nce, mB),
      AcceptedRecipientKey($src, $dst, ipkB),
      PersistA($src, $dst, ipkA, ipkB, ~K, Knext) ]->
  [ StA2($src, $dst, ipkA, ipkB, Knext) ]

lemma amf_secret [reuse, use_induction]:
  "All ipk ska #i #j. AmfKey(ipk, ska) @i & KU(ska) @j
    ==> Ex #r. Reveal(ipk) @r & #r < #j"

lemma state_secret [reuse, use_induction]:
  "All kk src dst ipkA ipkB #i #j.
      SetupState(kk,src,dst,ipkA,ipkB) @i & KU(kk) @j
    ==> Ex #r. RevealState(kk) @r & #r < #j"

lemma executable_direct: exists-trace
  "Ex src dst ts idA idB ipkA ipkB mA nce mB #i #j #k #l.
      FrankedRequest(src, dst, ts, ipkA, ipkB, mA) @i
    & DisplayCaller(dst, src, ts, idA, ipkA, ipkB, mA) @j
    & Answered(dst, src, ipkB, ipkA, nce, mB) @k
    & DisplayRecipient(src, dst, idB, ipkB, ipkA, nce, mB) @l
    & not (ipkA = ipkB)
    & #i < #j & #j < #k & #k < #l
    & not (Ex x #r. Reveal(x) @r)
    & not (Ex x #r. RevealId(x) @r)
    & not (Ex kk #r. RevealState(kk) @r)"

lemma executable_delegated: exists-trace
  "Ex src dst ts idO idB ipkO ipkD ipkB mA nce mB #i #j #k #l.
      FrankedRequestDelegated(src, dst, ipkO, ipkD) @i
    & DisplayCaller(dst, src, ts, idO, ipkD, ipkB, mA) @j
    & AcceptedDelegation(dst, src, ipkO, ipkD) @j
    & Answered(dst, src, ipkB, ipkD, nce, mB) @k
    & DisplayRecipient(src, dst, idB, ipkB, ipkD, nce, mB) @l
    & not (ipkD = ipkB) & not (ipkO = ipkD) & not (ipkO = ipkB)
    & #i < #j & #j < #k & #k < #l
    & not (Ex x #r. Reveal(x) @r)
    & not (Ex kk #r. RevealState(kk) @r)"

lemma auth1_caller_authentication:
  "All dst src ts id ipkS ipkB mA #i.
      DisplayCaller(dst, src, ts, id, ipkS, ipkB, mA) @i
     ==> ( (Ex #j. FrankedRequest(src, dst, ts, ipkS, ipkB, mA) @j & #j < #i)
         & (Ex ipkH #k. Enrolled(src, ipkH, id) @k & #k < #i) )
       | (Ex #r. Reveal(ipkS) @r) | (Ex #r. Reveal(ipkB) @r)"

lemma auth2_recipient_authentication [reuse]:
  "All src dst idB ipkB ipkA nce mB #i.
      DisplayRecipient(src, dst, idB, ipkB, ipkA, nce, mB) @i
     ==> (Ex #j. Answered(dst, src, ipkB, ipkA, nce, mB) @j & #j < #i)
       | (Ex #r. Reveal(ipkA) @r) | (Ex #r. Reveal(ipkB) @r)"

lemma auth2_recipient_authentication_injective:
  "All src dst idB ipkB ipkA nce mB #i1 #i2.
        DisplayRecipient(src, dst, idB, ipkB, ipkA, nce, mB) @i1
      & DisplayRecipient(src, dst, idB, ipkB, ipkA, nce, mB) @i2
     ==> #i1 = #i2
       | (Ex #r. Reveal(ipkA) @r) | (Ex #r. Reveal(ipkB) @r)"

lemma auth2_key_agreement:
  "All src dst ipkA ipkB kk knext #i.
      PersistA(src, dst, ipkA, ipkB, kk, knext) @i
     ==> (Ex #j. PersistB(dst, src, ipkB, ipkA, kk, knext) @j & #j < #i)
       | (Ex #r. Reveal(ipkA) @r) | (Ex #r. Reveal(ipkB) @r)
       | (Ex #r. RevealState(kk) @r)"

lemma auth2_key_agreement_with_exposed_state:
  "All src dst ipkA ipkB kk knext #i.
      PersistA(src, dst, ipkA, ipkB, kk, knext) @i
    ==> (Ex #j. PersistB(dst, src, ipkB, ipkA, kk, knext) @j & #j < #i)
      | (Ex #r. Reveal(ipkA) @r) | (Ex #r. Reveal(ipkB) @r)"

lemma auth4_recipient_identity_confidentiality_expected_falsified:
  "All tn ipkB idB #i #k. Enrolled(tn, ipkB, idB) @i & KU(idB) @k
     ==> (Ex dst src ipkA nce mB #j. Answered(dst, src, ipkB, ipkA, nce, mB) @j & #j < #k)
       | (Ex #r. RevealId(ipkB) @r) | (Ex #r. Reveal(ipkB) @r)
       | (Ex ipkD #r. RevealDtk(ipkB, ipkD) @r)"

lemma auth4_recipient_identity_confidentiality:
  "All tn ipk id #i #k. Enrolled(tn, ipk, id) @i & K(id) @k
    ==> (Ex role kk #s. IdentitySent(role, ipk, id, kk) @s & #s < #k)
      | (Ex #r. RevealId(ipk) @r & #r < #k)
      | (Ex ipkD #r. RevealDtk(ipk, ipkD) @r & #r < #k)"

lemma auth4_recipient_send_requires_answer:
  "All ipk id kk #i. IdentitySent('recipient', ipk, id, kk) @i
    ==> Ex dst src peer nce m. Answered(dst, src, ipk, peer, nce, m) @i"

lemma auth4_caller_disclosure_without_answer: exists-trace
  "Ex src dst ts ipkA ipkB id m kk #e #s #r #k.
      Enrolled(src, ipkA, id) @e
    & FrankedRequest(src, dst, ts, ipkA, ipkB, m) @s
    & IdentitySent('caller', ipkA, id, kk) @s
    & RevealState(kk) @r & K(id) @k
    & not (Ex x #j. Reveal(x) @j)
    & not (Ex x #j. RevealId(x) @j)
    & not (Ex x y z #j. Delegated(x,y,z) @j)
    & not (Ex x y z w n p #j. Answered(x,y,z,w,n,p) @j)"

lemma executable_with_state_reveal: exists-trace
  "Ex src dst ipkA ipkB id nce m kk knext #s #r #a.
      SetupState(kk,src,dst,ipkA,ipkB) @s & RevealState(kk) @r
    & DisplayRecipient(src,dst,id,ipkB,ipkA,nce,m) @a
    & PersistA(src,dst,ipkA,ipkB,kk,knext) @a & #r < #a
    & not (Ex x #j. Reveal(x) @j)"

lemma auth4_guard_satisfiable: exists-trace
  "Ex tn ipkB idB #i #k #r.
      Enrolled(tn, ipkB, idB) @i & KU(idB) @k & RevealId(ipkB) @r"

lemma del3_recipient_key_attested_for_dst:
  "All src dst ipkB #i. AcceptedRecipientKey(src, dst, ipkB) @i
     ==> (Ex idB #j. Enrolled(dst, ipkB, idB) @j & #j < #i)"

lemma del3_no_delegate_as_recipient:
  "not (Ex src dst ipkO ipkD #i #j.
          AcceptedRecipientKey(src, dst, ipkD) @i
        & Delegated(dst, ipkO, ipkD) @j
        & not (Ex idD #k. Enrolled(dst, ipkD, idD) @k))"

/* Confidentiality of transmitted identities, beyond disclosure ordering.
 * Reporting is outside this theory; disclosure by a compromised delegate device
 * and explicit device identity reveals are separate exceptions. Long-term key
 * disclosure alone is insufficient. */
lemma auth4_identity_secrecy:
  "All tn ipk id #e #k. Enrolled(tn,ipk,id) @e & K(id) @k
    ==> (Ex #r. RevealId(ipk) @r & #r < #k)
      | (Ex ipkD #r. RevealDtk(ipk,ipkD) @r & #r < #k)
      | (Ex role kk #s #r. IdentitySent(role,ipk,id,kk) @s
          & RevealState(kk) @r & #s < #k & #r < #k)"

/* Delegation authorization at call authentication: the delegation signature
 * Bob accepts originates from the owner's Delegate step unless the owner's
 * keys were exposed before acceptance. Mirrors the pairing model's lemma. */
lemma dlg_key_secret [reuse, use_induction]:
  "All ipk skb #i #j. DlgKey(ipk, skb) @i & KU(skb) @j
    ==> Ex #r. Reveal(ipk) @r & #r < #j"

lemma dlg_sig_origin [reuse, use_induction]:
  "All ipkO ipkD src skbO #i #e. DlgKey(ipkO, skbO) @e & KU(sign(<'dlg', ipkD, 'exD', src, 'orig'>, skbO)) @i
    ==> (Ex #j. Delegated(src, ipkO, ipkD) @j & #j < #i)
      | (Ex #r. Reveal(ipkO) @r & #r < #i)"

lemma del1_delegation_chain:
  "All dst src ipkO ipkD #i. AcceptedDelegation(dst, src, ipkO, ipkD) @i
     ==> ( (Ex idO #j. Enrolled(src, ipkO, idO) @j & #j < #i)
         & ( (Ex #j. Delegated(src, ipkO, ipkD) @j & #j < #i)
           | (Ex #r. Reveal(ipkO) @r & #r < #i) ) )"

/* Deniability witnesses. The designated receiver, represented by the attacker
 * holding only that receiver's long-term keys, the shared state, and the peer
 * identity the peer already disclosed to it, produces a message that the
 * receiver's own verification accepts although the peer never sent it. Such a
 * transcript therefore cannot serve as evidence of the peer's participation. */
lemma deniability_witness_ca_request: exists-trace
  "Ex src dst ts id ipkA ipkB mA kk #s #i.
      SetupState(kk, src, dst, ipkA, ipkB) @s
    & DisplayCaller(dst, src, ts, id, ipkA, ipkB, mA) @i
    & not (ipkA = ipkB)
    & not (Ex #j. FrankedRequest(src, dst, ts, ipkA, ipkB, mA) @j)
    & (All x #j. Reveal(x) @j ==> x = ipkB)
    & (All x #j. RevealId(x) @j ==> x = ipkA)
    & (All k #j. RevealState(k) @j ==> k = kk)"

lemma deniability_witness_ca_response: exists-trace
  "Ex src dst ts idB ipkA ipkB mA nce mB kk #s #q #i.
      SetupState(kk, src, dst, ipkA, ipkB) @s
    & FrankedRequest(src, dst, ts, ipkA, ipkB, mA) @q
    & DisplayRecipient(src, dst, idB, ipkB, ipkA, nce, mB) @i
    & not (ipkA = ipkB)
    & not (Ex x y z w n m #j. Answered(x, y, z, w, n, m) @j)
    & (All x #j. Reveal(x) @j ==> x = ipkA)
    & (All x #j. RevealId(x) @j ==> x = ipkB)
    & (All k #j. RevealState(k) @j ==> k = kk)"

end
