lemma auth1_caller_authentication:
  all-traces
  "∀ dst src ts id ipkS ipkB mA #i.
    (DisplayCaller( dst, src, ts, id, ipkS, ipkB, mA ) @ #i) ⇒
    ((((∃ #j.
         (FrankedRequest( src, dst, ts, ipkS, ipkB, mA ) @ #j) ∧ (#j < #i)) ∧
       (∃ ipkH #k. (Enrolled( src, ipkH, id ) @ #k) ∧ (#k < #i))) ∨
      (∃ #r. Reveal( ipkS ) @ #r)) ∨
     (∃ #r. Reveal( ipkB ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ dst src ts id ipkS ipkB mA #i.
  (DisplayCaller( dst, src, ts, id, ipkS, ipkB, mA ) @ #i)
 ∧
  (((∀ #j.
      (FrankedRequest( src, dst, ts, ipkS, ipkB, mA ) @ #j) ⇒ ¬(#j < #i)) ∨
    (∀ ipkH #k. (Enrolled( src, ipkH, id ) @ #k) ⇒ ¬(#k < #i)))) ∧
  (∀ #r. (Reveal( ipkS ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( ipkB ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma auth2_recipient_authentication [reuse]:
  all-traces
  "∀ src dst idB ipkB ipkA nce mB #i.
    (DisplayRecipient( src, dst, idB, ipkB, ipkA, nce, mB ) @ #i) ⇒
    (((∃ #j. (Answered( dst, src, ipkB, ipkA, nce, mB ) @ #j) ∧ (#j < #i)) ∨
      (∃ #r. Reveal( ipkA ) @ #r)) ∨
     (∃ #r. Reveal( ipkB ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ src dst idB ipkB ipkA nce mB #i.
  (DisplayRecipient( src, dst, idB, ipkB, ipkA, nce, mB ) @ #i)
 ∧
  (∀ #j. (Answered( dst, src, ipkB, ipkA, nce, mB ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #r. (Reveal( ipkA ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( ipkB ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma auth2_recipient_authentication_injective:
  all-traces
  "∀ src dst idB ipkB ipkA nce mB #i1 #i2.
    ((DisplayRecipient( src, dst, idB, ipkB, ipkA, nce, mB ) @ #i1) ∧
     (DisplayRecipient( src, dst, idB, ipkB, ipkA, nce, mB ) @ #i2)) ⇒
    (((#i1 = #i2) ∨ (∃ #r. Reveal( ipkA ) @ #r)) ∨
     (∃ #r. Reveal( ipkB ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ src dst idB ipkB ipkA nce mB #i1 #i2.
  (DisplayRecipient( src, dst, idB, ipkB, ipkA, nce, mB ) @ #i1) ∧
  (DisplayRecipient( src, dst, idB, ipkB, ipkA, nce, mB ) @ #i2)
 ∧
  (¬(#i1 = #i2)) ∧
  (∀ #r. (Reveal( ipkA ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( ipkB ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma auth2_key_agreement:
  all-traces
  "∀ src dst ipkA ipkB kk knext #i.
    (PersistA( src, dst, ipkA, ipkB, kk, knext ) @ #i) ⇒
    ((((∃ #j.
         (PersistB( dst, src, ipkB, ipkA, kk, knext ) @ #j) ∧ (#j < #i)) ∨
       (∃ #r. Reveal( ipkA ) @ #r)) ∨
      (∃ #r. Reveal( ipkB ) @ #r)) ∨
     (∃ #r. RevealState( kk ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ src dst ipkA ipkB kk knext #i.
  (PersistA( src, dst, ipkA, ipkB, kk, knext ) @ #i)
 ∧
  (∀ #j. (PersistB( dst, src, ipkB, ipkA, kk, knext ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #r. (Reveal( ipkA ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( ipkB ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevealState( kk ) @ #r) ⇒ ⊥)"
*/
simplify
solve( (∃ #j.
         (Answered( $dst, $src, <pk(skaB), vkbB, pkcB>, ipkA,
                    h(<'nce', mA, sigA>),
                    <'2', h(<'nce', mA, sigA>), B, 
                     <$dst, <pk(skaB), vkbB, pkcB>, 'ex', 
                      h(<'hid', idB, pk(skaB), vkbB, pkcB>), esigB>, 
                     idB>
          ) @ #j)
        ∧
         #j < #i)  ∥
       (∃ #r. (Reveal( ipkA ) @ #r))  ∥
       (∃ #r. (Reveal( <pk(skaB), vkbB, pkcB> ) @ #r)) )
  case case_1
  solve( StA1( $src, $dst, $ts, ipkA, <pk(skaB), vkbB, pkcB>, ~K, ~a,
               h(<'idxca', ~K, $src, $dst, $ts>), ctxA, mA, sigA
         )[no_precomp] ▶₀ #i )
    case CA_A1_delegated
    solve( !Token( $dst, <pk(skaB), vkbB, pkcB>,
                   h(<'hid', ~idB, pk(skaB), vkbB, pkcB>), esigB
           )[no_precomp] ▶₁ #i )
      case Enroll
      solve( !Au( pkAu )[no_precomp] ▶₂ #i )
        case Au_Init
        solve( !Amf( sigB,
                     <'2', 
                      h(<'nce', 
                         <'1', h(<'ratchet-context', ~K, h(<'idxca', ~K, $src, $dst, $ts>)>), 
                          <$src, $dst, $ts>, $ts, 'g'^~a, $ccx, ~idO, 
                          <$src, <pk(~skaO), pk(~skbO), pk(~skcO)>, 'ex', 
                           h(<'hid', ~idO, pk(~skaO), pk(~skbO), pk(~skcO)>), 
                           sign(<'etk', $src, <pk(~skaO), pk(~skbO), pk(~skcO)>, 'ex', 
                                 h(<'hid', ~idO, pk(~skaO), pk(~skbO), pk(~skcO)>)>,
                                ~skES)
                          >, 
                          'exD', <pk(~skaD), pk(~skbD), pk(~skcD)>, 
                          sign(<'dlg', <pk(~skaD), pk(~skbD), pk(~skcD)>, 'exD', $src, 'orig'>,
                               ~skbO)
                         >, 
                         ~sigA>), 
                      'g'^~b, 
                      <$dst, <pk(~ska), pk(~skb), pk(~skc)>, 'ex', 
                       h(<'hid', ~idB, pk(~ska), pk(~skb), pk(~skc)>), 
                       sign(<'etk', $dst, <pk(~ska), pk(~skb), pk(~skc)>, 'ex', 
                             h(<'hid', ~idB, pk(~ska), pk(~skb), pk(~skc)>)>,
                            ~skES)
                      >, 
                      ~idB>,
                     pk(~ska), <pk(~skaD), pk(~skbD), pk(~skcD)>, pk(~skAu)
               )[no_precomp] ▶₃ #i )
          case Adversary_Frank
          by contradiction /* from formulas */
        next
          case Adversary_Receiver_Forge
          by contradiction /* from formulas */
        next
          case CA_B_answer
          solve( StB3( $dst, $src, $ts.1, <pk(~ska), pk(~skb), pk(~skc)>,
                       <pk(~skaD), pk(~skbD), pk(~skcD)>, ~K.1, idx, ctxA,
                       <'1', h(<'ratchet-context', ~K, h(<'idxca', ~K, $src, $dst, $ts>)>), 
                        <$src, $dst, $ts>, $ts, 'g'^~a, $ccx, ~idO, 
                        <$src, <pk(~skaO), pk(~skbO), pk(~skcO)>, 'ex', 
                         h(<'hid', ~idO, pk(~skaO), pk(~skbO), pk(~skcO)>), 
                         sign(<'etk', $src, <pk(~skaO), pk(~skbO), pk(~skcO)>, 'ex', 
                               h(<'hid', ~idO, pk(~skaO), pk(~skbO), pk(~skcO)>)>,
                              ~skES)
                        >, 
                        'exD', <pk(~skaD), pk(~skbD), pk(~skcD)>, 
                        sign(<'dlg', <pk(~skaD), pk(~skbD), pk(~skcD)>, 'exD', $src, 'orig'>,
                             ~skbO)
                       >,
                       ~sigA, A
                 )[no_precomp] ▶₀ #j )
            case CA_B_verify_delegated
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  next
    case CA_A1_direct
    solve( !Token( $dst, <pk(skaB), vkbB, pkcB>,
                   h(<'hid', ~idB, pk(skaB), vkbB, pkcB>), esigB
           )[no_precomp] ▶₁ #i )
      case Enroll
      solve( !Au( pkAu )[no_precomp] ▶₂ #i )
        case Au_Init
        solve( !Amf( sigB,
                     <'2', 
                      h(<'nce', 
                         <'1', h(<'ratchet-context', ~K, h(<'idxca', ~K, $src, $dst, $ts>)>), 
                          <$src, $dst, $ts>, $ts, 'g'^~a, $ccx, 'nodlg', 
                          <$src, <pk(~ska), pk(~skb), pk(~skc)>, 'ex', 
                           h(<'hid', ~idA, pk(~ska), pk(~skb), pk(~skc)>), 
                           sign(<'etk', $src, <pk(~ska), pk(~skb), pk(~skc)>, 'ex', 
                                 h(<'hid', ~idA, pk(~ska), pk(~skb), pk(~skc)>)>,
                                ~skES)
                          >, 
                          ~idA>, 
                         ~sigA>), 
                      'g'^~b, 
                      <$dst, <pk(~ska.1), pk(~skb.1), pk(~skc.1)>, 'ex', 
