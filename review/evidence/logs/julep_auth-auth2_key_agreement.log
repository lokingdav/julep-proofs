theory JulepAuth

begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman
functions: adec/2, aead/4, aead_nonce/1, aead_open/3, aenc/2, fst/1, h/1,
           kdf/1, pair/2, pk/1, sdec/2, senc/2, sign/2, snd/1
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    aead_nonce(aead(m, k, r, ad)) = r,
    aead_open(aead(m, k, r, ad), k, ad) = m,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: S

restriction OnlyOnce:
  "∀ x #i #j. ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i #j. ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  */

rule (modulo E) ES_Init:
   [ Fr( ~skES ) ]
  --[ OnlyOnce( 'ES' ) ]->
   [ !ES( ~skES ), Out( pk(~skES) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Au_Init:
   [ Fr( ~skAu ) ]
  --[ OnlyOnce( 'Au' ) ]->
   [ !Au( pk(~skAu) ), Out( pk(~skAu) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Enroll:
   [ !ES( ~skES )[no_precomp], Fr( ~ska ), Fr( ~skb ), Fr( ~skc ), Fr( ~id )
