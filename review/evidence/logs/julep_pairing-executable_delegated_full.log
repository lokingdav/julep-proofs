                  >),
              ipkA, <vkaB, vkbB, pkcB>
     ),
     Out( <h(<'idx0', $src, $ts>), aenc(<'fin', 'g'^~a, z>, pkcB)> )
     ]
    variants (modulo AC)
    1. ~a    = ~a.33
