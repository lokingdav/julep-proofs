lemma executable:
  exists-trace
  "∃ src dst ts K ipkA ipkB #i #j.
    (((PairedA( src, dst, ts, K, ipkA, ipkB ) @ #i) ∧
      (PairedB( dst, src, ts, K, ipkB, ipkA ) @ #j)) ∧
     (¬(ipkA = ipkB))) ∧
    (¬(∃ x #r. Reveal( x ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ src dst ts K ipkA ipkB #i #j.
  (PairedA( src, dst, ts, K, ipkA, ipkB ) @ #i) ∧
  (PairedB( dst, src, ts, K, ipkB, ipkA ) @ #j)
 ∧
  (¬(ipkA = ipkB)) ∧ (∀ x #r. (Reveal( x ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma executable_delegated:
  exists-trace
  "∃ src dst ipkO ipkD #i #j.
    ((PairStartDelegated( src, ipkO, ipkD ) @ #i) ∧
     (AcceptedDelegation( dst, src, ipkO, ipkD ) @ #j)) ∧
    (¬(∃ x #r. Reveal( x ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ src dst ipkO ipkD #i #j.
  (PairStartDelegated( src, ipkO, ipkD ) @ #i) ∧
  (AcceptedDelegation( dst, src, ipkO, ipkD ) @ #j)
 ∧
  ∀ x #r. (Reveal( x ) @ #r) ⇒ ⊥"
*/
by sorry

lemma executable_delegated_full:
  exists-trace
  "∃ src dst ts K ipkO ipkD ipkB #i #j #k #l.
    (((((((PairStartDelegated( src, ipkO, ipkD ) @ #i) ∧
          (AcceptedDelegation( dst, src, ipkO, ipkD ) @ #j)) ∧
         (PairedA( src, dst, ts, K, ipkD, ipkB ) @ #k)) ∧
        (PairedB( dst, src, ts, K, ipkB, ipkD ) @ #l)) ∧
       (¬(ipkO = ipkD))) ∧
      (¬(ipkD = ipkB))) ∧
     (¬(ipkO = ipkB))) ∧
    (¬(∃ x #r. Reveal( x ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ src dst ts K ipkO ipkD ipkB #i #j #k #l.
  (PairStartDelegated( src, ipkO, ipkD ) @ #i) ∧
  (AcceptedDelegation( dst, src, ipkO, ipkD ) @ #j) ∧
  (PairedA( src, dst, ts, K, ipkD, ipkB ) @ #k) ∧
  (PairedB( dst, src, ts, K, ipkB, ipkD ) @ #l)
 ∧
  (¬(ipkO = ipkD)) ∧
  (¬(ipkD = ipkB)) ∧
  (¬(ipkO = ipkB)) ∧
  (∀ x #r. (Reveal( x ) @ #r) ⇒ ⊥)"
*/
simplify
solve( (∃ #j. (!KU( 'g'^~b.1 ) @ #j) ∧ #j < #k)  ∥
       (∃ #j. (SendB( 'g'^~b.1 ) @ #j) ∧ #j < #k) )
  case case_2
  solve( (∃ #j.
           (ResponseSent( 'g'^~b.1,
                          <'phi', piB.1, $dst.1, <vkaB, vkbB, pkcB>, 'ex', 'nodlg'>,
                          <vkaB, vkbB, pkcB>
            ) @ #j)
          ∧
           #j < #k)  ∥
         (∃ #j. (!KU( 'g'^~b.1 ) @ #j) ∧ #j < #k) )
    case case_1
    solve( !Dtk( $src, <vkaO, pk(skbO), pkcO>, <vkaD, vkbD, pkcD>,
                 <~idO, <$src, <vkaO, pk(skbO), pkcO>, 'ex', hidO, esigO>, 'exD', 
                  <vkaD, vkbD, pkcD>, dsig>
           )[no_precomp] ▶₀ #i )
      case Delegate
      solve( !Etk( $src, <pk(~skaO), pk(~skbO), pk(~skcO)>, ~idO,
                   <$src, <pk(~skaO), pk(~skbO), pk(~skcO)>, 'ex', 
                    h(<'hid', ~idO, pk(~skaO), pk(~skbO), pk(~skcO)>), 
                    sign(<'etk', $src, <pk(~skaO), pk(~skbO), pk(~skcO)>, 'ex', 
                          h(<'hid', ~idO, pk(~skaO), pk(~skbO), pk(~skcO)>)>,
                         ~skES)
                   >
             )[no_precomp] ▶₁ #i )
        case Enroll
        solve( !LtkK( <pk(~ska), pk(~skb), pk(~skc)>, ~skaD, ~skbD, ~skcD
               )[no_precomp] ▶₂ #i )
          case Enroll
          solve( !Etk( $dst.1, ipkB, ~idB, <$dst.1, ipkB, 'ex', hidB, esigB>
                 )[no_precomp] ▶₀ #j )
            case Enroll
            solve( !Proof( piA.1, $src, <pk(~skaO), pk(~skbO), pk(~skcO)>, hidO,
                           h(<'n0', h(<'idx0', $src, $ts.1>)>)
                   )[no_precomp] ▶₁ #j )
              case Adversary_Prove_Token
              solve( !KU( ~pi )[no_precomp] @ #vk.5 )
                case Adversary_Prove_Token
                solve( StA1( $src, $dst.1, $ts.2, <pk(~ska), pk(~skb), pk(~skc)>,
                             h(<'idx0', $src, $ts.2>), phiA
                       )[no_precomp] ▶₀ #k )
                  case Pair_A1_delegated
                  solve( !LtkK( <pk(~ska), pk(~skb), pk(~skc)>, ~ska.2, ~skb.2, ~skc.2
                         )[no_precomp] ▶₁ #k )
                    case Enroll
