  rule (modulo AC) CA_B2_answer:
     [
     CaStB( $dst, $src, ipkB, ipkA, ~k, h(hidx), cdt, mA, sigA, ctxA, A
     )[no_precomp],
     CurrentKey( 'rcp', ~k, ipkB, ipkA, exposed )[no_precomp],
     !Ltk( $dst, ipkB, ~skaB, ~skbB, ~skcB )[no_precomp], Fr( ~b ),
     Fr( ~sigB ), Fr( ~rhoB ),
     !Ltk( $src, ipkA, kaPeer, kbPeer, kcPeer )[no_precomp]
     ]
    --[
    DhSecret( z, ipkB, ipkA ),
    DerivedKey( kdf(<'ca', ~k, h(hidx), mA, sigA, 
                     <'2', h(<'nce', mA, sigA>), 'g'^~b>, ~sigB, z>),
                ipkB, ipkA
    ),
    AuthShare( A, ipkA, ipkB ), DhExp( ~b ), Answered( ipkB, ipkA, cdt ),
    CaDone( 'rcp', ipkB, ipkA, cdt ), SendShare( 'g'^~b ),
    FreshShare( 'g'^~b, ~b ), CallState( 'rcp', ipkB, ipkA, cdt )
    ]->
     [
     CallSt( 'rcp', $dst, $src, ipkB, ipkA, cdt, h(hidx),
             kdf(<'ca', ~k, h(hidx), mA, sigA, <'2', h(<'nce', mA, sigA>), 'g'^~b>, 
                  ~sigB, z>)
     ),
     CurrentKey( 'rcp',
                 kdf(<'ca', ~k, h(hidx), mA, sigA, <'2', h(<'nce', mA, sigA>), 'g'^~b>, 
                      ~sigB, z>),
                 ipkB, ipkA, 'private'
     ),
     !Amf( ~sigB, <'2', h(<'nce', mA, sigA>), 'g'^~b>, pk(~skaB), ipkA, 'mvk'
     ),
     Out( <h(hidx), 
           aead(<'carsp', <'2', h(<'nce', mA, sigA>), 'g'^~b>, ~sigB>, ~k, ~rhoB,
                <h(hidx), 'carsp', 'recipient'>)
          >
     )
     ]
    variants (modulo AC)
    1. ~b    = ~b.36
       A     = A.43
       z     = A.43^~b.36
    
