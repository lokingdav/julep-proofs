                             pk(~ska), <pk(~skaA), pk(~skbA), pk(~skcA)>, 'mvk'
                       )[no_precomp] ▶₂ #f )
                  case ICV_P3_decline
                  solve( !Ltk( $cd, <pk(~ska), pk(~skb), pk(~skc)>, ka0, kb0, kc0
                         )[no_precomp] ▶₄ #f )
                    case Enroll
                    solve( !Ltk( $cs, <pk(~skaA), pk(~skbA), pk(~skcA)>, ka1, kb1, kc1
                           )[no_precomp] ▶₅ #f )
                      case Enroll
                      solve( PendingDisplay( <pk(~skaA), pk(~skbA), pk(~skcA)>,
                                             <pk(~ska), pk(~skb), pk(~skc)>, <$cs, $cd, $cts>, $pl, chal,
                                             'nopres'
                             )[no_precomp] ▶₀ #i )
                        case ICV_R2
                        solve( CurrentKey( 'clr', ~k, <pk(~skaA), pk(~skbA), pk(~skcA)>,
                                           <pk(~ska), pk(~skb), pk(~skc)>, exposed
                               )[no_precomp] ▶₁ #vr )
                          case Inject_PairState
                          solve( !Amf( ~sigB,
                                       <'2', 
