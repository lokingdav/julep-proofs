                <'4', h(<'nce', mR, sigR>), 'g'^~b, 'nopres'>, ~sigP, A^~b>),
           ipkP, ipkR, cdt
  ),
  AuthShare( A, ipkR, ipkP ), IcvDeclined( role, ipkP, ipkR, cdt, pl ),
  SendShare( 'g'^~b ), FreshShare( 'g'^~b, ~b ),
  CallState( role, ipkP, ipkR, cdt )
  ]->
   [
   CallSt( role, $tnP, $tnR, ipkP, ipkR, cdt, h(hidx),
           kdf(<'icv', kj, h(hidx), mR, sigR, 
                <'4', h(<'nce', mR, sigR>), 'g'^~b, 'nopres'>, ~sigP, A^~b>)
   ),
   CurrentKey( role,
               kdf(<'icv', kj, h(hidx), mR, sigR, 
                    <'4', h(<'nce', mR, sigR>), 'g'^~b, 'nopres'>, ~sigP, A^~b>),
               ipkP, ipkR, 'private'
   ),
   !Amf( ~sigP, <'4', h(<'nce', mR, sigR>), 'g'^~b, 'nopres'>, pk(~skaP),
         ipkR, 'mvk'
   ),
   Out( <h(hidx), 
         aead(<'icvrsp', <'4', h(<'nce', mR, sigR>), 'g'^~b, 'nopres'>, ~sigP>,
              kj, ~rhoP, <h(hidx), 'icvrsp', 'prover'>)
        >
   )
   ]

  /*
  rule (modulo AC) ICV_P3_decline:
     [
     IcvAsk( role, $tnP, $tnR, ipkP, ipkR, cdt, h(hidx), kj, pl, ~b, mR, sigR,
             A, ctxR
     )[no_precomp],
     CurrentKey( role, kj, ipkP, ipkR, exposed )[no_precomp],
     !Ltk( $tnP, ipkP, ~skaP, ~skbP, ~skcP )[no_precomp], Fr( ~sigP ),
     Fr( ~rhoP ), !Ltk( $tnR, ipkR, kaPeer, kbPeer, kcPeer )[no_precomp]
     ]
    --[
    DhExp( ~b ), DhSecret( z, ipkP, ipkR ),
    DerivedKey( kdf(<'icv', kj, h(hidx), mR, sigR, 
                     <'4', h(<'nce', mR, sigR>), 'g'^~b, 'nopres'>, ~sigP, z>),
                ipkP, ipkR
    ),
    IcvKeyP( kdf(<'icv', kj, h(hidx), mR, sigR, 
                  <'4', h(<'nce', mR, sigR>), 'g'^~b, 'nopres'>, ~sigP, z>),
             ipkP, ipkR, cdt
    ),
    AuthShare( A, ipkR, ipkP ), IcvDeclined( role, ipkP, ipkR, cdt, pl ),
    SendShare( 'g'^~b ), FreshShare( 'g'^~b, ~b ),
    CallState( role, ipkP, ipkR, cdt )
    ]->
     [
     CallSt( role, $tnP, $tnR, ipkP, ipkR, cdt, h(hidx),
             kdf(<'icv', kj, h(hidx), mR, sigR, 
                  <'4', h(<'nce', mR, sigR>), 'g'^~b, 'nopres'>, ~sigP, z>)
     ),
     CurrentKey( role,
                 kdf(<'icv', kj, h(hidx), mR, sigR, 
                      <'4', h(<'nce', mR, sigR>), 'g'^~b, 'nopres'>, ~sigP, z>),
                 ipkP, ipkR, 'private'
     ),
     !Amf( ~sigP, <'4', h(<'nce', mR, sigR>), 'g'^~b, 'nopres'>, pk(~skaP),
           ipkR, 'mvk'
     ),
     Out( <h(hidx), 
           aead(<'icvrsp', <'4', h(<'nce', mR, sigR>), 'g'^~b, 'nopres'>, ~sigP>,
                kj, ~rhoP, <h(hidx), 'icvrsp', 'prover'>)
          >
     )
     ]
    variants (modulo AC)
    1. ~b    = ~b.37
       A     = A.43
       z     = A.43^~b.37
    
    2. ~b    = ~b.57
       A     = z.83^inv(~b.57)
       z     = z.83
    
    3. ~b    = ~b.390
       A     = x.775^x.776
       z     = x.775^(~b.390*x.776)
    
    4. ~b    = ~b.396
       A     = x.787^inv((~b.396*x.788))
       z     = x.787^inv(x.788)
    
    5. ~b    = ~b.396
       A     = x.787^(x.788*inv(~b.396))
       z     = x.787^x.788
    
    6. ~b    = ~b.397
       A     = x.788^(x.789*inv((~b.397*x.790)))
       z     = x.788^(x.789*inv(x.790))
    
    7. A     = DH_neutral
       z     = DH_neutral
  */

rule (modulo E) ICV_R2:
   [
   IcvStR( role, $tnR, $tnP, ipkR, <pk(skaP), vkbP, pkcP>, cdt, h(hidx), kj,
           pl, ~a, mR, sigR, ctxR
   )[no_precomp],
   CurrentKey( role, kj, ipkR, <pk(skaP), vkbP, pkcP>, exposed
   )[no_precomp],
   !Amf( sigP, <'4', h(<'nce', mR, sigR>), B, pres>, pk(skaP), ipkR, 'mvk'
   )[no_precomp],
   In( <h(hidx), 
        aead(<'icvrsp', <'4', h(<'nce', mR, sigR>), B, pres>, sigP>, kj, rhoP,
             <h(hidx), 'icvrsp', 'prover'>)
       >
   )[no_precomp],
   !Ltk( $tnP, <pk(skaP), vkbP, pkcP>, ka0, kb0, kc0 )[no_precomp],
   !Ltk( $tnR, ipkR, ka1, kb1, kc1 )[no_precomp]
   ]
  --[
  DhExp( ~a ), DhSecret( B^~a, ipkR, <pk(skaP), vkbP, pkcP> ),
  DerivedKey( kdf(<'icv', kj, h(hidx), mR, sigR, 
                   <'4', h(<'nce', mR, sigR>), B, pres>, sigP, B^~a>),
              ipkR, <pk(skaP), vkbP, pkcP>
  ),
  IcvKeyR( kdf(<'icv', kj, h(hidx), mR, sigR, 
                <'4', h(<'nce', mR, sigR>), B, pres>, sigP, B^~a>),
           ipkR, <pk(skaP), vkbP, pkcP>, cdt, pres
  ),
  IcvComplete( ipkR, <pk(skaP), vkbP, pkcP>, cdt ),
  AuthShare( B, <pk(skaP), vkbP, pkcP>, ipkR ), RecvShare( B ),
  CallState( role, ipkR, <pk(skaP), vkbP, pkcP>, cdt )
  ]->
   [
   CallSt( role, $tnR, $tnP, ipkR, <pk(skaP), vkbP, pkcP>, cdt, h(hidx),
           kdf(<'icv', kj, h(hidx), mR, sigR, <'4', h(<'nce', mR, sigR>), B, pres>, 
                sigP, B^~a>)
   ),
   CurrentKey( role,
               kdf(<'icv', kj, h(hidx), mR, sigR, <'4', h(<'nce', mR, sigR>), B, pres>, 
                    sigP, B^~a>),
               ipkR, <pk(skaP), vkbP, pkcP>, 'private'
   ),
   PendingDisplay( ipkR, <pk(skaP), vkbP, pkcP>, cdt, pl,
                   h(<'chal', kj, h(<'nce', mR, sigR>), B>), pres
   )
   ]

  /*
  rule (modulo AC) ICV_R2:
     [
     IcvStR( role, $tnR, $tnP, ipkR, <pk(skaP), vkbP, pkcP>, cdt, h(hidx), kj,
             pl, ~a, mR, sigR, ctxR
     )[no_precomp],
     CurrentKey( role, kj, ipkR, <pk(skaP), vkbP, pkcP>, exposed
     )[no_precomp],
     !Amf( sigP, <'4', h(<'nce', mR, sigR>), B, pres>, pk(skaP), ipkR, 'mvk'
     )[no_precomp],
     In( <h(hidx), 
          aead(<'icvrsp', <'4', h(<'nce', mR, sigR>), B, pres>, sigP>, kj, rhoP,
               <h(hidx), 'icvrsp', 'prover'>)
         >
     )[no_precomp],
     !Ltk( $tnP, <pk(skaP), vkbP, pkcP>, ka0, kb0, kc0 )[no_precomp],
     !Ltk( $tnR, ipkR, ka1, kb1, kc1 )[no_precomp]
     ]
    --[
    DhExp( ~a ), DhSecret( z, ipkR, <pk(skaP), vkbP, pkcP> ),
    DerivedKey( kdf(<'icv', kj, h(hidx), mR, sigR, 
                     <'4', h(<'nce', mR, sigR>), B, pres>, sigP, z>),
                ipkR, <pk(skaP), vkbP, pkcP>
    ),
    IcvKeyR( kdf(<'icv', kj, h(hidx), mR, sigR, 
                  <'4', h(<'nce', mR, sigR>), B, pres>, sigP, z>),
             ipkR, <pk(skaP), vkbP, pkcP>, cdt, pres
    ),
    IcvComplete( ipkR, <pk(skaP), vkbP, pkcP>, cdt ),
    AuthShare( B, <pk(skaP), vkbP, pkcP>, ipkR ), RecvShare( B ),
    CallState( role, ipkR, <pk(skaP), vkbP, pkcP>, cdt )
    ]->
     [
     CallSt( role, $tnR, $tnP, ipkR, <pk(skaP), vkbP, pkcP>, cdt, h(hidx),
             kdf(<'icv', kj, h(hidx), mR, sigR, <'4', h(<'nce', mR, sigR>), B, pres>, 
                  sigP, z>)
     ),
     CurrentKey( role,
                 kdf(<'icv', kj, h(hidx), mR, sigR, <'4', h(<'nce', mR, sigR>), B, pres>, 
                      sigP, z>),
                 ipkR, <pk(skaP), vkbP, pkcP>, 'private'
     ),
     PendingDisplay( ipkR, <pk(skaP), vkbP, pkcP>, cdt, pl,
                     h(<'chal', kj, h(<'nce', mR, sigR>), B>), pres
     )
     ]
    variants (modulo AC)
    1. ~a    = ~a.36
       B     = B.37
       z     = B.37^~a.36
    
    2. ~a    = ~a.65
       B     = z.95^inv(~a.65)
       z     = z.95
    
    3. ~a    = ~a.267
       B     = x.529^x.530
       z     = x.529^(~a.267*x.530)
    
    4. ~a    = ~a.268
       B     = x.531^inv((~a.268*x.532))
       z     = x.531^inv(x.532)
    
    5. ~a    = ~a.268
       B     = x.531^(x.532*inv(~a.268))
       z     = x.531^x.532
    
    6. ~a    = ~a.269
       B     = x.532^(x.533*inv((~a.269*x.534)))
       z     = x.532^(x.533*inv(x.534))
    
    7. B     = DH_neutral
