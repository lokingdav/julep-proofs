                           ~a, mR, sigR.1, ctxR
                   )[no_precomp] ▶₀ #f )
              case ICV_R1
              solve( CurrentKey( 'clr',
                                 kdf(<'ca', ~k.1, h(<'idx', ~k.1, $cs, $cd, $cts>), 
                                      <'1', h(<'ratchet-context', ~k.1, h(<'idx', ~k.1, $cs, $cd, $cts>)>), 
                                       <$cs, $cd, $cts>, 'g'^~a>, 
                                      ~sigA.1, 
                                      <'2', 
                                       h(<'nce', 
                                          <'1', 
                                           h(<'ratchet-context', ~k.1, h(<'idx', ~k.1, $cs, $cd, $cts>)>), 
                                           <$cs, $cd, $cts>, 'g'^~a>, 
                                          ~sigA.1>), 
                                       B>, 
                                      sigB.1, z.2>),
                                 <pk(~skaA), pk(~skbA), pk(~skcA)>, <pk(~ska), pk(~skb), pk(~skc)>,
