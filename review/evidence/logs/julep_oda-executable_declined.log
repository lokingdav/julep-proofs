        (∀ ro x y c p #r. (IcvDeclined( ro, x, y, c, p ) @ #r) ⇒ (#r = #d))) ∧
       (∀ x y c #r. (IcvComplete( x, y, c ) @ #r) ⇒ (#r = #f))) ∧
      (¬(∃ ro x y c p pr k #r. Present( ro, x, y, c, p, pr, k ) @ #r))) ∧
     (¬(∃ x #r. Reveal( x ) @ #r))) ∧
    (¬(∃ k x y #r. RevealState( k, x, y ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ ipkR ipkP cdt pl #q #d #f #i.
  (IcvRequest( ipkR, ipkP, cdt, pl ) @ #q) ∧
  (IcvDeclined( 'rcp', ipkP, ipkR, cdt, pl ) @ #d) ∧
