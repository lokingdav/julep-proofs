  (∀ x #r. (Reveal( x ) @ #r) ⇒ ⊥) ∧
  (∀ k x y #r. (RevealState( k, x, y ) @ #r) ⇒ ⊥)"
*/
simplify
solve( CallSt( role, $tnR, $tnP, ipkR, <pk(skaP), vkbP, pkcP>,
               <$cs, $cd, $cts>, h(hidx), kj
       )[no_precomp] ▶₀ #q )
