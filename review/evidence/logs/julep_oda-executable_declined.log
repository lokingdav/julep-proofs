                                                <$cs, $cd, $cts>, 'g'^~a>,
                                               pk(~skaA), <pk(~ska), pk(~skb), pk(~skc)>, 'mvk'
                                         )[no_precomp] ▶₁ #vr.8 )
                                    case CA_A1
                                    solve( !KU( h(<'idx', ~k, $cs, $cd, $cts>) )[no_precomp] @ #vk.1 )
                                      case CA_A1
                                      solve( !KU( aead(<'icvrsp', 
                                                        <'4', 
                                                         h(<'nce', 
                                                            <'3', 
                                                             h(<'ratchet-context', 
                                                                kdf(<'ca', ~k, 
                                                                     h(<'idx', ~k, $cs, $cd, $cts>), 
                                                                     <'1', 
                                                                      h(<'ratchet-context', ~k, 
                                                                         h(<'idx', ~k, $cs, $cd, $cts>)>), 
                                                                      <$cs, $cd, $cts>, 'g'^~a>, 
                                                                     ~sigA, 
                                                                     <'2', 
                                                                      h(<'nce', 
                                                                         <'1', 
                                                                          h(<'ratchet-context', ~k, 
                                                                             h(<'idx', ~k, $cs, $cd, $cts>)
                                                                            >), 
                                                                          <$cs, $cd, $cts>, 'g'^~a>, 
                                                                         ~sigA>), 
