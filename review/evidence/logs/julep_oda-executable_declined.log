  "∀ z ipkX ipkY #i.
    (DhSecret( z, ipkX, ipkY ) @ #i) ⇒
    (((¬(∃ #j. !KU( z ) @ #j)) ∨ (∃ #r. (Reveal( ipkX ) @ #r) ∧ (#r < #i))) ∨
     (∃ #r. (Reveal( ipkY ) @ #r) ∧ (#r < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ z ipkX ipkY #i.
  (DhSecret( z, ipkX, ipkY ) @ #i)
 ∧
  (∃ #j. (!KU( z ) @ #j)) ∧
  (∀ #r. (Reveal( ipkX ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (Reveal( ipkY ) @ #r) ⇒ ¬(#r < #i))"
*/
by sorry

lemma derived_key_secret [reuse, hide_lemma=authenticated_share_origin]:
  all-traces
  "∀ k ipkX ipkY #i.
    (DerivedKey( k, ipkX, ipkY ) @ #i) ⇒
    ((((¬(∃ #j. !KU( k ) @ #j)) ∨
       (∃ #r. (Reveal( ipkX ) @ #r) ∧ (#r < #i))) ∨
      (∃ #r. (Reveal( ipkY ) @ #r) ∧ (#r < #i))) ∨
     (∃ x y #r. RevealState( k, x, y ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ k ipkX ipkY #i.
  (DerivedKey( k, ipkX, ipkY ) @ #i)
 ∧
  (∃ #j. (!KU( k ) @ #j)) ∧
  (∀ #r. (Reveal( ipkX ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (Reveal( ipkY ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ x y #r. (RevealState( k, x, y ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma callst_only_after_ca [reuse, use_induction, heuristic=S,
                            hide_lemma=dh_exponents_secret, hide_lemma=authenticated_share_origin,
                            hide_lemma=dh_shared_secret, hide_lemma=derived_key_secret]:
  all-traces
  "∀ role ipkS ipkO cdt #i.
    (CallState( role, ipkS, ipkO, cdt ) @ #i) ⇒
    (∃ #c. (CaDone( role, ipkS, ipkO, cdt ) @ #c) ∧ ((#c < #i) ∨ (#c = #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ role ipkS ipkO cdt #i.
  (CallState( role, ipkS, ipkO, cdt ) @ #i)
 ∧
  ∀ #c.
   (CaDone( role, ipkS, ipkO, cdt ) @ #c) ⇒ (¬(#c < #i)) ∧ (¬(#c = #i))"
*/
by sorry

