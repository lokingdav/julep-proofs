lemma ltk_secret [reuse]:
  all-traces
  "∀ ipk ska skb skc #i.
    (LtkGen( ipk, ska, skb, skc ) @ #i) ⇒
    ((((¬(∃ #k. !KU( ska ) @ #k)) ∧ (¬(∃ #k. !KU( skb ) @ #k))) ∧
      (¬(∃ #k. !KU( skc ) @ #k))) ∨
     (∃ #r. Reveal( ipk ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ ipk ska skb skc #i.
  (LtkGen( ipk, ska, skb, skc ) @ #i)
 ∧
  (((∃ #k. (!KU( ska ) @ #k)) ∨
    (∃ #k. (!KU( skb ) @ #k)) ∨
    (∃ #k. (!KU( skc ) @ #k)))) ∧
  (∀ #r. (Reveal( ipk ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma cred_sig_secret [reuse]:
  all-traces
  "∀ ipk pl attr csig #i.
    (CredIssued( ipk, pl, attr, csig ) @ #i) ⇒ (¬(∃ #k. !KU( csig ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ ipk pl attr csig #i.
  (CredIssued( ipk, pl, attr, csig ) @ #i) ∧ ∃ #k. (!KU( csig ) @ #k)"
*/
by sorry

lemma dh_exponents_secret [reuse]:
  all-traces "∀ x #i. (DhExp( x ) @ #i) ⇒ (¬(∃ #j. !KU( x ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (DhExp( x ) @ #i) ∧ ∃ #j. (!KU( x ) @ #j)"
*/
by sorry

lemma ltk_secret_ordered [reuse, use_induction]:
  all-traces
  "∀ ipk ska skb skc #i #k.
    ((LtkGen( ipk, ska, skb, skc ) @ #i) ∧ (!KU( ska ) @ #k)) ⇒
    (∃ #r. (Reveal( ipk ) @ #r) ∧ (#r < #k))"
/*
guarded formula characterizing all counter-examples:
"∃ ipk ska skb skc #i #k.
  (LtkGen( ipk, ska, skb, skc ) @ #i) ∧ (!KU( ska ) @ #k)
 ∧
  ∀ #r. (Reveal( ipk ) @ #r) ⇒ ¬(#r < #k)"
*/
by sorry

lemma authenticated_share_origin [reuse, hide_lemma=ltk_secret]:
  all-traces
  "∀ X ipkS ipkR #i.
    (AuthShare( X, ipkS, ipkR ) @ #i) ⇒
    (((∃ x #s. (FreshShare( X, x ) @ #s) ∧ (#s < #i)) ∨
      (∃ #r. (Reveal( ipkS ) @ #r) ∧ (#r < #i))) ∨
     (∃ #r. (Reveal( ipkR ) @ #r) ∧ (#r < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ X ipkS ipkR #i.
  (AuthShare( X, ipkS, ipkR ) @ #i)
 ∧
  (∀ x #s. (FreshShare( X, x ) @ #s) ⇒ ¬(#s < #i)) ∧
  (∀ #r. (Reveal( ipkS ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (Reveal( ipkR ) @ #r) ⇒ ¬(#r < #i))"
*/
by sorry

