   !Ltk( $tnR, <pk(skaR), vkbR, pkcR>, ka0, kb0, kc0 )[no_precomp],
   !Ltk( $tnP, ipkP, ka1, kb1, kc1 )[no_precomp]
   ]
  --[
  DhExp( ~b ),
  IcvAccept( role, ipkP, <pk(skaR), vkbR, pkcR>, <$cs, $cd, $cts>, pl ),
  Challenge( h(<'chal', kj, 
                h(<'nce', 
