                 h(hidx), kj, pl, ~a, mR, sigR, ctxR
         )[no_precomp] ▶₀ #i )
    case ICV_R1
    solve( !Amf( sigP,
                 <'4', 
                  h(<'nce', 
                     <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, $pl, 'g'^~a
                     >, 
