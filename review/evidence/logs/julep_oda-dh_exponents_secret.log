      case ICV_P3_present
      solve( !Amf( ~sigR,
                   <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, $pl, 'g'^~a
                   >,
                   pk(~skaR), <pk(~skaP), pk(~skbP), pk(~skcP)>, 'mvk'
             )[no_precomp] ▶₁ #vr.7 )
        case ICV_R1
        solve( !KU( ~a ) @ #j )
          case Reveal_State_Initial
          by solve( CurrentKey( role.2, ~a, ipkX, ipkY, 'private'
                    )[no_precomp] ▶₀ #vr.9 )
        qed
      qed
    qed
  qed
qed

