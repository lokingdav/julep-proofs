                )[no_precomp] ▶₀ #vr.3 )
    qed
  qed
next
  case ICV_P3_decline
  solve( IcvAsk( role, $tnP, $tnR, ipkP, ipkR, cdt, h(hidx), kj, pl, ~b,
                 mR, sigR, A, ctxR
         )[no_precomp] ▶₀ #i )
    case ICV_P1_accept
    solve( !Amf( sigR,
                 <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, pl, A>,
                 pk(~ska.1), <pk(~ska), pk(~skb), pk(~skc)>, 'mvk'
           )[no_precomp] ▶₁ #vr )
      case Adversary_Frank
      solve( !KU( ~b ) @ #j )
        case Reveal_State_Initial
        by solve( CurrentKey( role.1, ~b, ipkX, ipkY, 'private'
                  )[no_precomp] ▶₀ #vr.5 )
      qed
    next
      case Adversary_Receiver_Forge
      solve( !KU( ~b ) @ #j )
        case Reveal_State_Initial
        by solve( CurrentKey( role.1, ~b, ipkX, ipkY, 'private'
                  )[no_precomp] ▶₀ #vr.5 )
      qed
    next
      case ICV_R1
      solve( !KU( ~b ) @ #j )
        case Reveal_State_Initial
        by solve( CurrentKey( role.2, ~b, ipkX, ipkY, 'private'
                  )[no_precomp] ▶₀ #vr.5 )
