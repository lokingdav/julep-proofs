lemma ltk_secret [reuse]:
  all-traces
  "∀ ipk ska skb skc #i.
    (LtkGen( ipk, ska, skb, skc ) @ #i) ⇒
    ((((¬(∃ #k. !KU( ska ) @ #k)) ∧ (¬(∃ #k. !KU( skb ) @ #k))) ∧
      (¬(∃ #k. !KU( skc ) @ #k))) ∨
     (∃ #r. Reveal( ipk ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ ipk ska skb skc #i.
  (LtkGen( ipk, ska, skb, skc ) @ #i)
 ∧
  (((∃ #k. (!KU( ska ) @ #k)) ∨
    (∃ #k. (!KU( skb ) @ #k)) ∨
    (∃ #k. (!KU( skc ) @ #k)))) ∧
  (∀ #r. (Reveal( ipk ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma cred_sig_secret [reuse]:
  all-traces
  "∀ ipk pl attr csig #i.
    (CredIssued( ipk, pl, attr, csig ) @ #i) ⇒ (¬(∃ #k. !KU( csig ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ ipk pl attr csig #i.
  (CredIssued( ipk, pl, attr, csig ) @ #i) ∧ ∃ #k. (!KU( csig ) @ #k)"
*/
by sorry

lemma dh_exponents_secret [reuse]:
  all-traces "∀ x #i. (DhExp( x ) @ #i) ⇒ (¬(∃ #j. !KU( x ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (DhExp( x ) @ #i) ∧ ∃ #j. (!KU( x ) @ #j)"
*/
simplify
solve( DhExp( x ) @ #i )
  case CA_A1
  solve( !KU( ~a ) @ #j )
    case Reveal_State_Initial
    by solve( CurrentKey( role, ~a, ipkX, ipkY, 'private'
              )[no_precomp] ▶₀ #vr )
  qed
next
  case CA_A2
  solve( CaStA( $src, $dst, ipkA, <pk(skaB), vkbB, pkcB>, ~k, ~a, h(hidx),
                cdt, mA, sigA, ctxA
         )[no_precomp] ▶₀ #i )
    case CA_A1
    solve( !Amf( sigB,
                 <'2', 
                  h(<'nce', 
                     <'1', h(<'ratchet-context', ~k, h(<'idx', ~k, $src, $dst, $ts>)>), 
                      <$src, $dst, $ts>, 'g'^~a>, 
                     ~sigA>), 
                  B>,
                 pk(~skaB), <pk(~skaA), pk(~skbA), pk(~skcA)>, 'mvk'
           )[no_precomp] ▶₂ #i )
      case Adversary_Frank
      solve( !KU( ~a ) @ #j )
        case Reveal_State_Initial
        by solve( CurrentKey( role, ~a, ipkX, ipkY, 'private'
                  )[no_precomp] ▶₀ #vr.6 )
      qed
    next
      case Adversary_Receiver_Forge
      solve( !KU( ~a ) @ #j )
        case Reveal_State_Initial
        by solve( CurrentKey( role, ~a, ipkX, ipkY, 'private'
                  )[no_precomp] ▶₀ #vr.6 )
      qed
    next
      case CA_B2_answer
      solve( !Amf( ~sigA,
                   <'1', h(<'ratchet-context', ~k, h(<'idx', ~k, $src, $dst, $ts>)>), 
                    <$src, $dst, $ts>, 'g'^~a>,
                   pk(~skaA), <pk(~skaB), pk(~skbB), pk(~skcB)>, 'mvk'
             )[no_precomp] ▶₁ #vr.6 )
        case CA_A1
        solve( !KU( ~a ) @ #j )
          case Reveal_State_Initial
          by solve( CurrentKey( role, ~a, ipkX, ipkY, 'private'
                    )[no_precomp] ▶₀ #vr.7 )
        qed
      qed
    qed
  qed
next
  case CA_B2_answer
  solve( !KU( ~b ) @ #j )
    case Reveal_State_Initial
    by solve( CurrentKey( role, ~b, ipkX, ipkY, 'private'
              )[no_precomp] ▶₀ #vr )
  qed
next
  case ICV_P1_accept
  solve( !Amf( sigR,
               <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, pl, A>,
               pk(skaR), ipkP, 'mvk'
         )[no_precomp] ▶₁ #i )
    case Adversary_Frank
    solve( !KU( ~b ) @ #j )
      case Reveal_State_Initial
      by solve( CurrentKey( role.1, ~b, ipkX, ipkY, 'private'
                )[no_precomp] ▶₀ #vr.1 )
    qed
  next
    case Adversary_Receiver_Forge
    solve( !KU( ~b ) @ #j )
      case Reveal_State_Initial
      by solve( CurrentKey( role.1, ~b, ipkX, ipkY, 'private'
                )[no_precomp] ▶₀ #vr.1 )
    qed
  next
    case ICV_R1
