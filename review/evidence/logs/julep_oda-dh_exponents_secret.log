theory JulepODA

begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman
functions: adec/2, aead/4, aead_nonce/1, aead_open/3, aenc/2, fst/1, h/1,
           kdf/1, pair/2, pk/1, pok/4, sdec/2, senc/2, sign/2, snd/1
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    aead_nonce(aead(m, k, r, ad)) = r,
    aead_open(aead(m, k, r, ad), k, ad) = m,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: S

restriction OnlyOnce:
  "∀ x #i #j. ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i #j. ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  */

rule (modulo E) ES_Init:
   [ Fr( ~skES ) ]
  --[ OnlyOnce( 'ES' ) ]->
   [ !ES( ~skES ), Out( pk(~skES) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Enroll:
   [ !ES( ~skES )[no_precomp], Fr( ~ska ), Fr( ~skb ), Fr( ~skc ), Fr( ~id )
   ]
  --[
  Enrolled( $tn, <pk(~ska), pk(~skb), pk(~skc)>, ~id ),
  LtkGen( <pk(~ska), pk(~skb), pk(~skc)>, ~ska, ~skb, ~skc )
  ]->
   [
   !Ltk( $tn, <pk(~ska), pk(~skb), pk(~skc)>, ~ska, ~skb, ~skc ),
   !Etk( $tn, <pk(~ska), pk(~skb), pk(~skc)>, ~id,
         <$tn, <pk(~ska), pk(~skb), pk(~skc)>, 'ex', 
          h(<'hid', ~id, pk(~ska), pk(~skb), pk(~skc)>), 
          sign(<'etk', $tn, <pk(~ska), pk(~skb), pk(~skc)>, 'ex', 
                h(<'hid', ~id, pk(~ska), pk(~skb), pk(~skc)>)>,
               ~skES)
         >
   ),
   Out( <$tn, <pk(~ska), pk(~skb), pk(~skc)>, 'ex', 
         h(<'hid', ~id, pk(~ska), pk(~skb), pk(~skc)>), 
         sign(<'etk', $tn, <pk(~ska), pk(~skb), pk(~skc)>, 'ex', 
               h(<'hid', ~id, pk(~ska), pk(~skb), pk(~skc)>)>,
              ~skES)
        >
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Delegate:
   [
   !Ltk( $src, <pk(~skaO), pk(~skbO), pk(~skcO)>, ~skaO, ~skbO, ~skcO
   )[no_precomp],
   !Etk( $src, <pk(~skaO), pk(~skbO), pk(~skcO)>, ~idO, etkO )[no_precomp],
   !Etk( $tnD, ipkD, ~idD, etkD )[no_precomp]
   ]
  --[ Delegated( $src, <pk(~skaO), pk(~skbO), pk(~skcO)>, ipkD ) ]->
   [
   !Dtk( $src, <pk(~skaO), pk(~skbO), pk(~skcO)>, ipkD,
         <~idO, etkO, 'exD', ipkD, sign(<'dlg', ipkD, 'exD', $src, 'orig'>, ~skbO)
         >
   ),
   Out( <etkO, 'exD', ipkD, sign(<'dlg', ipkD, 'exD', $src, 'orig'>, ~skbO)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Ltk:
   [ !Ltk( $tn, ipk, ~ska, ~skb, ~skc )[no_precomp] ]
  --[ Reveal( ipk ) ]->
   [ Out( <~ska, ~skb, ~skc> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) IdP_Init:
   [ Fr( ~skI ) ]
  --[ OnlyOnce( 'IdP' ) ]->
   [ !IdP( ~skI ), !IdPPublic( pk(~skI) ), Out( pk(~skI) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Issue_Cred:
   [
   !IdP( ~skI )[no_precomp], !Ltk( $tn, ipk, ~ska, ~skb, ~skc )[no_precomp]
   ]
  --[
  IssuedCred( ipk, $pl, $attr ),
  CredIssued( ipk, $pl, $attr, sign(<'crd', $pl, $attr, ipk>, ~skI) )
  ]->
   [ !Cred( ipk, $pl, $attr, sign(<'crd', $pl, $attr, ipk>, ~skI) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Adversary_Frank:
   [ In( <m, sk, ipkR> )[no_precomp], Fr( ~sig ) ]
  -->
   [ !Amf( ~sig, m, pk(sk), ipkR, 'mvk' ), Out( ~sig ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Adversary_Receiver_Forge:
   [ In( <m, vkaS, skR, vkbR, pkcR> )[no_precomp], Fr( ~sig ) ]
  -->
   [ !Amf( ~sig, m, vkaS, <pk(skR), vkbR, pkcR>, 'mvk' ), Out( ~sig ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Inject_PairState:
   [
   Fr( ~k ),
   !Ltk( $src, <pk(~skaA), pk(~skbA), pk(~skcA)>, ~skaA, ~skbA, ~skcA
   )[no_precomp],
   !Ltk( $dst, <pk(~skaB), pk(~skbB), pk(~skcB)>, ~skaB, ~skbB, ~skcB
   )[no_precomp]
   ]
  --[
  Paired( $src, $dst, <pk(~skaA), pk(~skbA), pk(~skcA)>,
          <pk(~skaB), pk(~skbB), pk(~skcB)>, ~k
  )
  ]->
   [
   PairStA( $src, $dst, <pk(~skaA), pk(~skbA), pk(~skcA)>,
            <pk(~skaB), pk(~skbB), pk(~skcB)>, ~k
   ),
   PairStB( $dst, $src, <pk(~skaB), pk(~skbB), pk(~skcB)>,
            <pk(~skaA), pk(~skbA), pk(~skcA)>, ~k
   ),
   CurrentKey( 'clr', ~k, <pk(~skaA), pk(~skbA), pk(~skcA)>,
               <pk(~skaB), pk(~skbB), pk(~skcB)>, 'private'
   ),
   CurrentKey( 'rcp', ~k, <pk(~skaB), pk(~skbB), pk(~skcB)>,
               <pk(~skaA), pk(~skbA), pk(~skcA)>, 'private'
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_State_Initial:
   [ CurrentKey( role, ~k, ipkX, ipkY, 'private' )[no_precomp] ]
  --[ RevealState( ~k, ipkX, ipkY ) ]->
   [ CurrentKey( role, ~k, ipkX, ipkY, 'exposed' ), Out( ~k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_State_Derived:
   [ CurrentKey( role, kdf(inputs), ipkX, ipkY, 'private' )[no_precomp] ]
  --[ RevealState( kdf(inputs), ipkX, ipkY ) ]->
   [
   CurrentKey( role, kdf(inputs), ipkX, ipkY, 'exposed' ),
   Out( kdf(inputs) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CA_A1:
   [
   PairStA( $src, $dst, ipkA, ipkB, ~k )[no_precomp],
   !Ltk( $src, ipkA, ~skaA, ~skbA, ~skcA )[no_precomp], Fr( ~a ),
   Fr( ~sigA ), Fr( ~rhoA )
   ]
  --[
  DhExp( ~a ), CaRequest( ipkA, ipkB, <$src, $dst, $ts> ),
  SendShare( 'g'^~a ), FreshShare( 'g'^~a, ~a )
  ]->
   [
   CaStA( $src, $dst, ipkA, ipkB, ~k, ~a, h(<'idx', ~k, $src, $dst, $ts>),
          <$src, $dst, $ts>,
          <'1', h(<'ratchet-context', ~k, h(<'idx', ~k, $src, $dst, $ts>)>), 
           <$src, $dst, $ts>, 'g'^~a>,
          ~sigA,
          aead(<'careq', 
                <'1', h(<'ratchet-context', ~k, h(<'idx', ~k, $src, $dst, $ts>)>), 
                 <$src, $dst, $ts>, 'g'^~a>, 
                ~sigA>,
               ~k, ~rhoA, <h(<'idx', ~k, $src, $dst, $ts>), 'careq', 'caller'>)
   ),
   !Amf( ~sigA,
         <'1', h(<'ratchet-context', ~k, h(<'idx', ~k, $src, $dst, $ts>)>), 
          <$src, $dst, $ts>, 'g'^~a>,
         pk(~skaA), ipkB, 'mvk'
   ),
   Out( <h(<'idx', ~k, $src, $dst, $ts>), 
         aead(<'careq', 
               <'1', h(<'ratchet-context', ~k, h(<'idx', ~k, $src, $dst, $ts>)>), 
                <$src, $dst, $ts>, 'g'^~a>, 
               ~sigA>,
              ~k, ~rhoA, <h(<'idx', ~k, $src, $dst, $ts>), 'careq', 'caller'>)
        >
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CA_B1_display:
   [
   PairStB( $dst, $src, ipkB, <pk(skaA), vkbA, pkcA>, ~k )[no_precomp],
   !Amf( sigA,
         <'1', h(<'ratchet-context', ~k, h(<'idx', ~k, $src, $dst, $ts>)>), 
          <$src, $dst, $ts>, A>,
         pk(skaA), ipkB, 'mvk'
   )[no_precomp],
   In( <h(<'idx', ~k, $src, $dst, $ts>), 
        aead(<'careq', 
              <'1', h(<'ratchet-context', ~k, h(<'idx', ~k, $src, $dst, $ts>)>), 
               <$src, $dst, $ts>, A>, 
              sigA>,
             ~k, rhoA, <h(<'idx', ~k, $src, $dst, $ts>), 'careq', 'caller'>)
       >
   )[no_precomp],
   !Ltk( $src, <pk(skaA), vkbA, pkcA>, ka0, kb0, kc0 )[no_precomp],
   !Ltk( $dst, ipkB, ka1, kb1, kc1 )[no_precomp]
   ]
  --[
  CaDisplay( ipkB, <pk(skaA), vkbA, pkcA>, <$src, $dst, $ts> ),
  AuthShare( A, <pk(skaA), vkbA, pkcA>, ipkB ), RecvShare( A )
  ]->
   [
   CaStB( $dst, $src, ipkB, <pk(skaA), vkbA, pkcA>, ~k,
          h(<'idx', ~k, $src, $dst, $ts>), <$src, $dst, $ts>,
          <'1', h(<'ratchet-context', ~k, h(<'idx', ~k, $src, $dst, $ts>)>), 
           <$src, $dst, $ts>, A>,
          sigA,
          aead(<'careq', 
                <'1', h(<'ratchet-context', ~k, h(<'idx', ~k, $src, $dst, $ts>)>), 
                 <$src, $dst, $ts>, A>, 
                sigA>,
               ~k, rhoA, <h(<'idx', ~k, $src, $dst, $ts>), 'careq', 'caller'>),
          A
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CA_B2_answer:
   [
   CaStB( $dst, $src, ipkB, ipkA, ~k, h(hidx), cdt, mA, sigA, ctxA, A
   )[no_precomp],
   CurrentKey( 'rcp', ~k, ipkB, ipkA, exposed )[no_precomp],
   !Ltk( $dst, ipkB, ~skaB, ~skbB, ~skcB )[no_precomp], Fr( ~b ),
   Fr( ~sigB ), Fr( ~rhoB ),
   !Ltk( $src, ipkA, kaPeer, kbPeer, kcPeer )[no_precomp]
   ]
  --[
  DhSecret( A^~b, ipkB, ipkA ),
  DerivedKey( kdf(<'ca', ~k, h(hidx), mA, sigA, 
                   <'2', h(<'nce', mA, sigA>), 'g'^~b>, ~sigB, A^~b>),
              ipkB, ipkA
  ),
  AuthShare( A, ipkA, ipkB ), DhExp( ~b ), Answered( ipkB, ipkA, cdt ),
  CaDone( 'rcp', ipkB, ipkA, cdt ), SendShare( 'g'^~b ),
  FreshShare( 'g'^~b, ~b ), CallState( 'rcp', ipkB, ipkA, cdt )
  ]->
   [
   CallSt( 'rcp', $dst, $src, ipkB, ipkA, cdt, h(hidx),
           kdf(<'ca', ~k, h(hidx), mA, sigA, <'2', h(<'nce', mA, sigA>), 'g'^~b>, 
                ~sigB, A^~b>)
   ),
   CurrentKey( 'rcp',
               kdf(<'ca', ~k, h(hidx), mA, sigA, <'2', h(<'nce', mA, sigA>), 'g'^~b>, 
                    ~sigB, A^~b>),
               ipkB, ipkA, 'private'
   ),
   !Amf( ~sigB, <'2', h(<'nce', mA, sigA>), 'g'^~b>, pk(~skaB), ipkA, 'mvk'
   ),
   Out( <h(hidx), 
         aead(<'carsp', <'2', h(<'nce', mA, sigA>), 'g'^~b>, ~sigB>, ~k, ~rhoB,
              <h(hidx), 'carsp', 'recipient'>)
        >
   )
   ]

  /*
  rule (modulo AC) CA_B2_answer:
     [
     CaStB( $dst, $src, ipkB, ipkA, ~k, h(hidx), cdt, mA, sigA, ctxA, A
     )[no_precomp],
     CurrentKey( 'rcp', ~k, ipkB, ipkA, exposed )[no_precomp],
     !Ltk( $dst, ipkB, ~skaB, ~skbB, ~skcB )[no_precomp], Fr( ~b ),
     Fr( ~sigB ), Fr( ~rhoB ),
     !Ltk( $src, ipkA, kaPeer, kbPeer, kcPeer )[no_precomp]
     ]
    --[
    DhSecret( z, ipkB, ipkA ),
    DerivedKey( kdf(<'ca', ~k, h(hidx), mA, sigA, 
                     <'2', h(<'nce', mA, sigA>), 'g'^~b>, ~sigB, z>),
                ipkB, ipkA
    ),
    AuthShare( A, ipkA, ipkB ), DhExp( ~b ), Answered( ipkB, ipkA, cdt ),
    CaDone( 'rcp', ipkB, ipkA, cdt ), SendShare( 'g'^~b ),
    FreshShare( 'g'^~b, ~b ), CallState( 'rcp', ipkB, ipkA, cdt )
    ]->
     [
     CallSt( 'rcp', $dst, $src, ipkB, ipkA, cdt, h(hidx),
             kdf(<'ca', ~k, h(hidx), mA, sigA, <'2', h(<'nce', mA, sigA>), 'g'^~b>, 
                  ~sigB, z>)
     ),
     CurrentKey( 'rcp',
                 kdf(<'ca', ~k, h(hidx), mA, sigA, <'2', h(<'nce', mA, sigA>), 'g'^~b>, 
                      ~sigB, z>),
                 ipkB, ipkA, 'private'
     ),
     !Amf( ~sigB, <'2', h(<'nce', mA, sigA>), 'g'^~b>, pk(~skaB), ipkA, 'mvk'
     ),
     Out( <h(hidx), 
           aead(<'carsp', <'2', h(<'nce', mA, sigA>), 'g'^~b>, ~sigB>, ~k, ~rhoB,
                <h(hidx), 'carsp', 'recipient'>)
          >
     )
     ]
    variants (modulo AC)
    1. ~b    = ~b.36
       A     = A.43
       z     = A.43^~b.36
    
    2. ~b    = ~b.366
       A     = x.727^x.728
       z     = x.727^(~b.366*x.728)
    
    3. A     = DH_neutral
       z     = DH_neutral
  */

rule (modulo E) CA_A2:
   [
   CaStA( $src, $dst, ipkA, <pk(skaB), vkbB, pkcB>, ~k, ~a, h(hidx), cdt,
          mA, sigA, ctxA
   )[no_precomp],
   CurrentKey( 'clr', ~k, ipkA, <pk(skaB), vkbB, pkcB>, exposed
   )[no_precomp],
   !Amf( sigB, <'2', h(<'nce', mA, sigA>), B>, pk(skaB), ipkA, 'mvk'
   )[no_precomp],
   In( <h(hidx), 
        aead(<'carsp', <'2', h(<'nce', mA, sigA>), B>, sigB>, ~k, rhoB,
             <h(hidx), 'carsp', 'recipient'>)
       >
   )[no_precomp],
   !Ltk( $dst, <pk(skaB), vkbB, pkcB>, ka0, kb0, kc0 )[no_precomp],
   !Ltk( $src, ipkA, ka1, kb1, kc1 )[no_precomp]
   ]
  --[
  DhExp( ~a ), DhSecret( B^~a, ipkA, <pk(skaB), vkbB, pkcB> ),
  DerivedKey( kdf(<'ca', ~k, h(hidx), mA, sigA, 
                   <'2', h(<'nce', mA, sigA>), B>, sigB, B^~a>),
              ipkA, <pk(skaB), vkbB, pkcB>
  ),
  CaDone( 'clr', ipkA, <pk(skaB), vkbB, pkcB>, cdt ),
  AuthShare( B, <pk(skaB), vkbB, pkcB>, ipkA ), RecvShare( B ),
  CallState( 'clr', ipkA, <pk(skaB), vkbB, pkcB>, cdt )
  ]->
   [
   CallSt( 'clr', $src, $dst, ipkA, <pk(skaB), vkbB, pkcB>, cdt, h(hidx),
           kdf(<'ca', ~k, h(hidx), mA, sigA, <'2', h(<'nce', mA, sigA>), B>, sigB, 
                B^~a>)
   ),
   CurrentKey( 'clr',
               kdf(<'ca', ~k, h(hidx), mA, sigA, <'2', h(<'nce', mA, sigA>), B>, sigB, 
                    B^~a>),
               ipkA, <pk(skaB), vkbB, pkcB>, 'private'
   )
   ]

  /*
  rule (modulo AC) CA_A2:
     [
     CaStA( $src, $dst, ipkA, <pk(skaB), vkbB, pkcB>, ~k, ~a, h(hidx), cdt,
            mA, sigA, ctxA
     )[no_precomp],
     CurrentKey( 'clr', ~k, ipkA, <pk(skaB), vkbB, pkcB>, exposed
     )[no_precomp],
     !Amf( sigB, <'2', h(<'nce', mA, sigA>), B>, pk(skaB), ipkA, 'mvk'
     )[no_precomp],
     In( <h(hidx), 
          aead(<'carsp', <'2', h(<'nce', mA, sigA>), B>, sigB>, ~k, rhoB,
               <h(hidx), 'carsp', 'recipient'>)
         >
     )[no_precomp],
     !Ltk( $dst, <pk(skaB), vkbB, pkcB>, ka0, kb0, kc0 )[no_precomp],
     !Ltk( $src, ipkA, ka1, kb1, kc1 )[no_precomp]
     ]
    --[
    DhExp( ~a ), DhSecret( z, ipkA, <pk(skaB), vkbB, pkcB> ),
    DerivedKey( kdf(<'ca', ~k, h(hidx), mA, sigA, 
                     <'2', h(<'nce', mA, sigA>), B>, sigB, z>),
                ipkA, <pk(skaB), vkbB, pkcB>
    ),
    CaDone( 'clr', ipkA, <pk(skaB), vkbB, pkcB>, cdt ),
    AuthShare( B, <pk(skaB), vkbB, pkcB>, ipkA ), RecvShare( B ),
    CallState( 'clr', ipkA, <pk(skaB), vkbB, pkcB>, cdt )
    ]->
     [
     CallSt( 'clr', $src, $dst, ipkA, <pk(skaB), vkbB, pkcB>, cdt, h(hidx),
             kdf(<'ca', ~k, h(hidx), mA, sigA, <'2', h(<'nce', mA, sigA>), B>, sigB, z
                 >)
     ),
     CurrentKey( 'clr',
                 kdf(<'ca', ~k, h(hidx), mA, sigA, <'2', h(<'nce', mA, sigA>), B>, sigB, z
                     >),
                 ipkA, <pk(skaB), vkbB, pkcB>, 'private'
     )
     ]
    variants (modulo AC)
    1. ~a    = ~a.35
       B     = B.37
       z     = B.37^~a.35
    
    2. ~a    = ~a.61
       B     = z.89^inv(~a.61)
       z     = z.89
    
    3. ~a    = ~a.244
       B     = x.483^x.484
       z     = x.483^(~a.244*x.484)
    
    4. ~a    = ~a.246
       B     = x.487^inv((~a.246*x.488))
       z     = x.487^inv(x.488)
    
    5. ~a    = ~a.246
       B     = x.487^(x.488*inv(~a.246))
       z     = x.487^x.488
    
    6. ~a    = ~a.247
       B     = x.488^(x.489*inv((~a.247*x.490)))
       z     = x.488^(x.489*inv(x.490))
    
    7. B     = DH_neutral
       z     = DH_neutral
  */

rule (modulo E) ICV_R1:
   [
   CallSt( role, $tnR, $tnP, ipkR, ipkP, <$cs, $cd, $cts>, h(hidx), kj
   )[no_precomp],
   !Ltk( $tnR, ipkR, ~skaR, ~skbR, ~skcR )[no_precomp], Fr( ~a ),
   Fr( ~sigR ), Fr( ~rhoR )
   ]
  --[
  DhExp( ~a ), IcvRequest( ipkR, ipkP, <$cs, $cd, $cts>, $pl ),
  SendShare( 'g'^~a ), FreshShare( 'g'^~a, ~a )
  ]->
   [
   IcvStR( role, $tnR, $tnP, ipkR, ipkP, <$cs, $cd, $cts>, h(hidx), kj, $pl,
           ~a,
           <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, $pl, 'g'^~a
           >,
           ~sigR,
           aead(<'icvreq', 
                 <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, $pl, 'g'^~a
                 >, 
                 ~sigR>,
                kj, ~rhoR, <h(hidx), 'icvreq', 'requester'>)
   ),
   !Amf( ~sigR,
         <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, $pl, 'g'^~a
         >,
         pk(~skaR), ipkP, 'mvk'
   ),
   Out( <h(hidx), 
         aead(<'icvreq', 
               <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, $pl, 'g'^~a
               >, 
               ~sigR>,
              kj, ~rhoR, <h(hidx), 'icvreq', 'requester'>)
        >
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ICV_P1_accept:
   [
   CallSt( role, $tnP, $tnR, ipkP, <pk(skaR), vkbR, pkcR>, <$cs, $cd, $cts>,
           h(hidx), kj
   )[no_precomp],
   !Amf( sigR,
         <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, pl, A>,
         pk(skaR), ipkP, 'mvk'
   )[no_precomp],
   In( <h(hidx), 
        aead(<'icvreq', 
              <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, pl, A>, sigR
             >,
             kj, rhoR, <h(hidx), 'icvreq', 'requester'>)
       >
   )[no_precomp],
   Fr( ~b ),
   !Ltk( $tnR, <pk(skaR), vkbR, pkcR>, ka0, kb0, kc0 )[no_precomp],
   !Ltk( $tnP, ipkP, ka1, kb1, kc1 )[no_precomp]
   ]
  --[
  DhExp( ~b ),
  IcvAccept( role, ipkP, <pk(skaR), vkbR, pkcR>, <$cs, $cd, $cts>, pl ),
  Challenge( h(<'chal', kj, 
                h(<'nce', 
                   <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, pl, A>, sigR
                  >), 
                'g'^~b>)
  ),
  AuthShare( A, <pk(skaR), vkbR, pkcR>, ipkP ), RecvShare( A )
  ]->
   [
   IcvAsk( role, $tnP, $tnR, ipkP, <pk(skaR), vkbR, pkcR>, <$cs, $cd, $cts>,
           h(hidx), kj, pl, ~b,
           <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, pl, A>,
           sigR, A,
           aead(<'icvreq', 
                 <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, pl, A>, sigR
                >,
                kj, rhoR, <h(hidx), 'icvreq', 'requester'>)
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ICV_P2_consent:
   [
   IcvAsk( role, $tnP, $tnR, ipkP, ipkR, cdt, idx, kj, pl, ~b, mR, sigR, A,
           ctxR
   )[no_precomp]
   ]
