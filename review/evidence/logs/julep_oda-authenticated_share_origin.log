                  hide_lemma=dh_exponents_secret, hide_lemma=authenticated_share_origin,
                  hide_lemma=dh_shared_secret, hide_lemma=derived_key_secret,
                  hide_lemma=callst_only_after_ca, hide_lemma=ca_caller_requires_answer,
                  hide_lemma=oda2_present_after_ca,
                  hide_lemma=oda2_recipient_present_after_answer,
                  hide_lemma=presentation_key_origin, hide_lemma=oda2_presentation_secret]:
  exists-trace
  "∃ ipkP ipkR cdt pl pres kj attr #a #c #i #d #q #f.
    ((((((((((((((((((IcvComplete( ipkR, ipkP, cdt ) @ #f) ∧
                     (¬(ipkP = ipkR))) ∧
                    (#i < #f)) ∧
                   (#f < #d)) ∧
                  (∀ x y c.1 #r. (IcvComplete( x, y, c.1 ) @ #r) ⇒ (#r = #f))) ∧
                 (IcvRequest( ipkR, ipkP, cdt, pl ) @ #q)) ∧
                (Answered( ipkP, ipkR, cdt ) @ #a)) ∧
               (Consent( ipkP, ipkR, cdt, pl ) @ #c)) ∧
              (Present( 'rcp', ipkP, ipkR, cdt, pl, pres, kj ) @ #i)) ∧
             (Displayed( ipkR, ipkP, cdt, pl, attr, pres ) @ #d)) ∧
            (#q < #c)) ∧
