                  <'4', h(<'nce', mR, sigR>), 'g'^~b, 'pres', 
                   pok(csig, ipkP, h(<'chal', kj, h(<'nce', mR, sigR>), 'g'^~b>),
                       ~proof_random), 
                   $attr, pl>, 
                  ~sigP, z>)
     ),
     CurrentKey( role,
                 kdf(<'icv', kj, h(hidx), mR, sigR, 
                      <'4', h(<'nce', mR, sigR>), 'g'^~b, 'pres', 
                       pok(csig, ipkP, h(<'chal', kj, h(<'nce', mR, sigR>), 'g'^~b>),
                           ~proof_random), 
                       $attr, pl>, 
                      ~sigP, z>),
                 ipkP, ipkR, 'private'
     ),
     !Amf( ~sigP,
           <'4', h(<'nce', mR, sigR>), 'g'^~b, 'pres', 
            pok(csig, ipkP, h(<'chal', kj, h(<'nce', mR, sigR>), 'g'^~b>),
                ~proof_random), 
            $attr, pl>,
           pk(~skaP), ipkR, 'mvk'
     ),
     Out( <h(hidx), 
           aead(<'icvrsp', 
                 <'4', h(<'nce', mR, sigR>), 'g'^~b, 'pres', 
                  pok(csig, ipkP, h(<'chal', kj, h(<'nce', mR, sigR>), 'g'^~b>),
                      ~proof_random), 
                  $attr, pl>, 
                 ~sigP>,
                kj, ~rhoP, <h(hidx), 'icvrsp', 'prover'>)
          >
     )
     ]
    variants (modulo AC)
    1. ~b    = ~b.42
       A     = A.49
       z     = A.49^~b.42
    
    2. ~b    = ~b.64
       A     = z.93^inv(~b.64)
       z     = z.93
    
    3. ~b    = ~b.462
       A     = x.918^x.919
       z     = x.918^(~b.462*x.919)
    
    4. ~b    = ~b.469
       A     = x.932^inv((~b.469*x.933))
       z     = x.932^inv(x.933)
    
    5. ~b    = ~b.469
       A     = x.932^(x.933*inv(~b.469))
       z     = x.932^x.933
    
    6. ~b    = ~b.470
       A     = x.933^(x.934*inv((~b.470*x.935)))
       z     = x.933^(x.934*inv(x.935))
    
    7. A     = DH_neutral
       z     = DH_neutral
  */

