lemma dh_shared_secret [reuse]:
  all-traces
  "∀ z ipkX ipkY #i.
    (DhSecret( z, ipkX, ipkY ) @ #i) ⇒
    (((¬(∃ #j. !KU( z ) @ #j)) ∨ (∃ #r. (Reveal( ipkX ) @ #r) ∧ (#r < #i))) ∨
     (∃ #r. (Reveal( ipkY ) @ #r) ∧ (#r < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ z ipkX ipkY #i.
  (DhSecret( z, ipkX, ipkY ) @ #i)
 ∧
  (∃ #j. (!KU( z ) @ #j)) ∧
  (∀ #r. (Reveal( ipkX ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (Reveal( ipkY ) @ #r) ⇒ ¬(#r < #i))"
*/
by sorry

