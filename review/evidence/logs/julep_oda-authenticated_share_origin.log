   [
   IcvAskOk( role, $tnP, $tnR, ipkP, ipkR, cdt, idx, kj, pl, ~b, mR, sigR,
             A, ctxR
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ICV_P3_present:
