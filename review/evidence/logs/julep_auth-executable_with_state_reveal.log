                 <'2', h(<'nce', mA, sigA>), 'g'^~b, <$dst, ipkB, 'ex', hidB, esigB>, ~idB
                 >, 
                 ~sigB, A^~b>)
  )
  ]->
   [
   StB4( $dst, $src, ipkB, ipkAstar,
         kdf(<~K, idx, mA, sigA, 
              <'2', h(<'nce', mA, sigA>), 'g'^~b, <$dst, ipkB, 'ex', hidB, esigB>, ~idB
              >, 
              ~sigB, A^~b>)
   ),
   !Amf( ~sigB,
         <'2', h(<'nce', mA, sigA>), 'g'^~b, <$dst, ipkB, 'ex', hidB, esigB>, ~idB
         >,
         pk(~skaB), ipkAstar, pkAu
   ),
   Out( <idx, 
         aead(<
               <'2', h(<'nce', mA, sigA>), 'g'^~b, <$dst, ipkB, 'ex', hidB, esigB>, ~idB
               >, 
               ~sigB>,
              ~K, ~rhoB, <idx, '2', 'recipient'>)
        >
   )
   ]

  /*
  rule (modulo AC) CA_B_answer:
     [
     StB3( $dst, $src, $ts, ipkB, ipkAstar, ~K, idx, ctxA, mA, sigA, A
     )[no_precomp],
     !Etk( $dst, ipkB, ~idB, <$dst, ipkB, 'ex', hidB, esigB> )[no_precomp],
     !Ltk( $dst, ipkB, ~skaB, ~skbB, ~skcB )[no_precomp],
     !Au( pkAu )[no_precomp], Fr( ~b ), Fr( ~sigB ), Fr( ~rhoB )
     ]
    --[
    IdentitySent( 'recipient', ipkB, ~idB, ~K ),
    Answered( $dst, $src, ipkB, ipkAstar, h(<'nce', mA, sigA>),
              <'2', h(<'nce', mA, sigA>), 'g'^~b, <$dst, ipkB, 'ex', hidB, esigB>, ~idB
              >
    ),
    DhExp( ~b ),
    Franked( <'2', h(<'nce', mA, sigA>), 'g'^~b, 
              <$dst, ipkB, 'ex', hidB, esigB>, ~idB>,
             ~skaB, ipkAstar, pkAu
    ),
    PersistB( $dst, $src, ipkB, ipkAstar, ~K,
              kdf(<~K, idx, mA, sigA, 
                   <'2', h(<'nce', mA, sigA>), 'g'^~b, <$dst, ipkB, 'ex', hidB, esigB>, ~idB
                   >, 
                   ~sigB, z>)
    )
    ]->
     [
     StB4( $dst, $src, ipkB, ipkAstar,
           kdf(<~K, idx, mA, sigA, 
                <'2', h(<'nce', mA, sigA>), 'g'^~b, <$dst, ipkB, 'ex', hidB, esigB>, ~idB
                >, 
                ~sigB, z>)
     ),
     !Amf( ~sigB,
           <'2', h(<'nce', mA, sigA>), 'g'^~b, <$dst, ipkB, 'ex', hidB, esigB>, ~idB
           >,
           pk(~skaB), ipkAstar, pkAu
     ),
     Out( <idx, 
           aead(<
                 <'2', h(<'nce', mA, sigA>), 'g'^~b, <$dst, ipkB, 'ex', hidB, esigB>, ~idB
                 >, 
                 ~sigB>,
                ~K, ~rhoB, <idx, '2', 'recipient'>)
          >
     )
     ]
    variants (modulo AC)
    1. ~b    = ~b.35
       A     = A.42
       z     = A.42^~b.35
    
    2. ~b    = ~b.203
       A     = x.399^x.400
       z     = x.399^(~b.203*x.400)
    
    3. A     = DH_neutral
       z     = DH_neutral
  */

rule (modulo E) CA_A2:
   [
   StA1( $src, $dst, $ts, ipkA, <pk(skaB), vkbB, pkcB>, ~K, ~a,
         h(<'idxca', ~K, $src, $dst, $ts>), ctxA, mA, sigA
   )[no_precomp],
   !Token( $dst, <pk(skaB), vkbB, pkcB>,
           h(<'hid', idB, pk(skaB), vkbB, pkcB>), esigB
   )[no_precomp],
   !Au( pkAu )[no_precomp],
   !Amf( sigB,
         <'2', h(<'nce', mA, sigA>), B, 
          <$dst, <pk(skaB), vkbB, pkcB>, 'ex', 
           h(<'hid', idB, pk(skaB), vkbB, pkcB>), esigB>, 
          idB>,
         pk(skaB), ipkA, pkAu
   )[no_precomp],
   In( <h(<'idxca', ~K, $src, $dst, $ts>), 
        aead(<
              <'2', h(<'nce', mA, sigA>), B, 
               <$dst, <pk(skaB), vkbB, pkcB>, 'ex', 
                h(<'hid', idB, pk(skaB), vkbB, pkcB>), esigB>, 
               idB>, 
              sigB>,
             ~K, rhoB, <h(<'idxca', ~K, $src, $dst, $ts>), '2', 'recipient'>)
       >
   )[no_precomp]
   ]
  --[
  DisplayRecipient( $src, $dst, idB, <pk(skaB), vkbB, pkcB>, ipkA,
                    h(<'nce', mA, sigA>),
                    <'2', h(<'nce', mA, sigA>), B, 
                     <$dst, <pk(skaB), vkbB, pkcB>, 'ex', 
                      h(<'hid', idB, pk(skaB), vkbB, pkcB>), esigB>, 
                     idB>
  ),
  AcceptedRecipientKey( $src, $dst, <pk(skaB), vkbB, pkcB> ),
  PersistA( $src, $dst, ipkA, <pk(skaB), vkbB, pkcB>, ~K,
            kdf(<~K, h(<'idxca', ~K, $src, $dst, $ts>), mA, sigA, 
                 <'2', h(<'nce', mA, sigA>), B, 
                  <$dst, <pk(skaB), vkbB, pkcB>, 'ex', 
                   h(<'hid', idB, pk(skaB), vkbB, pkcB>), esigB>, 
                  idB>, 
                 sigB, B^~a>)
  )
  ]->
   [
   StA2( $src, $dst, ipkA, <pk(skaB), vkbB, pkcB>,
         kdf(<~K, h(<'idxca', ~K, $src, $dst, $ts>), mA, sigA, 
              <'2', h(<'nce', mA, sigA>), B, 
               <$dst, <pk(skaB), vkbB, pkcB>, 'ex', 
                h(<'hid', idB, pk(skaB), vkbB, pkcB>), esigB>, 
               idB>, 
              sigB, B^~a>)
   )
   ]

  /*
  rule (modulo AC) CA_A2:
     [
     StA1( $src, $dst, $ts, ipkA, <pk(skaB), vkbB, pkcB>, ~K, ~a,
           h(<'idxca', ~K, $src, $dst, $ts>), ctxA, mA, sigA
     )[no_precomp],
     !Token( $dst, <pk(skaB), vkbB, pkcB>,
             h(<'hid', idB, pk(skaB), vkbB, pkcB>), esigB
     )[no_precomp],
     !Au( pkAu )[no_precomp],
     !Amf( sigB,
           <'2', h(<'nce', mA, sigA>), B, 
            <$dst, <pk(skaB), vkbB, pkcB>, 'ex', 
             h(<'hid', idB, pk(skaB), vkbB, pkcB>), esigB>, 
            idB>,
           pk(skaB), ipkA, pkAu
     )[no_precomp],
     In( <h(<'idxca', ~K, $src, $dst, $ts>), 
          aead(<
                <'2', h(<'nce', mA, sigA>), B, 
                 <$dst, <pk(skaB), vkbB, pkcB>, 'ex', 
                  h(<'hid', idB, pk(skaB), vkbB, pkcB>), esigB>, 
                 idB>, 
                sigB>,
               ~K, rhoB, <h(<'idxca', ~K, $src, $dst, $ts>), '2', 'recipient'>)
         >
     )[no_precomp]
     ]
    --[
    DisplayRecipient( $src, $dst, idB, <pk(skaB), vkbB, pkcB>, ipkA,
                      h(<'nce', mA, sigA>),
                      <'2', h(<'nce', mA, sigA>), B, 
                       <$dst, <pk(skaB), vkbB, pkcB>, 'ex', 
                        h(<'hid', idB, pk(skaB), vkbB, pkcB>), esigB>, 
                       idB>
    ),
    AcceptedRecipientKey( $src, $dst, <pk(skaB), vkbB, pkcB> ),
    PersistA( $src, $dst, ipkA, <pk(skaB), vkbB, pkcB>, ~K,
              kdf(<~K, h(<'idxca', ~K, $src, $dst, $ts>), mA, sigA, 
                   <'2', h(<'nce', mA, sigA>), B, 
                    <$dst, <pk(skaB), vkbB, pkcB>, 'ex', 
                     h(<'hid', idB, pk(skaB), vkbB, pkcB>), esigB>, 
                    idB>, 
                   sigB, z>)
    )
    ]->
     [
     StA2( $src, $dst, ipkA, <pk(skaB), vkbB, pkcB>,
           kdf(<~K, h(<'idxca', ~K, $src, $dst, $ts>), mA, sigA, 
                <'2', h(<'nce', mA, sigA>), B, 
                 <$dst, <pk(skaB), vkbB, pkcB>, 'ex', 
                  h(<'hid', idB, pk(skaB), vkbB, pkcB>), esigB>, 
                 idB>, 
                sigB, z>)
     )
     ]
    variants (modulo AC)
    1. ~a    = ~a.28
       B     = B.29
       z     = B.29^~a.28
    
    2. ~a    = ~a.47
       B     = z.67^inv(~a.47)
       z     = z.67
    
    3. ~a    = ~a.133
       B     = x.259^x.260
       z     = x.259^(~a.133*x.260)
    
    4. ~a    = ~a.134
       B     = x.261^inv((~a.134*x.262))
       z     = x.261^inv(x.262)
    
    5. ~a    = ~a.134
       B     = x.261^(x.262*inv(~a.134))
       z     = x.261^x.262
    
    6. ~a    = ~a.135
       B     = x.262^(x.263*inv((~a.135*x.264)))
       z     = x.262^(x.263*inv(x.264))
    
    7. B     = DH_neutral
       z     = DH_neutral
  */

lemma amf_secret [reuse, use_induction]:
  all-traces
  "∀ ipk ska #i #j.
    ((AmfKey( ipk, ska ) @ #i) ∧ (!KU( ska ) @ #j)) ⇒
    (∃ #r. (Reveal( ipk ) @ #r) ∧ (#r < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ ipk ska #i #j.
  (AmfKey( ipk, ska ) @ #i) ∧ (!KU( ska ) @ #j)
 ∧
  ∀ #r. (Reveal( ipk ) @ #r) ⇒ ¬(#r < #j)"
*/
by sorry

lemma state_secret [reuse, use_induction]:
  all-traces
  "∀ kk src dst ipkA ipkB #i #j.
    ((SetupState( kk, src, dst, ipkA, ipkB ) @ #i) ∧ (!KU( kk ) @ #j)) ⇒
    (∃ #r. (RevealState( kk ) @ #r) ∧ (#r < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ kk src dst ipkA ipkB #i #j.
  (SetupState( kk, src, dst, ipkA, ipkB ) @ #i) ∧ (!KU( kk ) @ #j)
 ∧
  ∀ #r. (RevealState( kk ) @ #r) ⇒ ¬(#r < #j)"
*/
by sorry

lemma executable_direct:
  exists-trace
  "∃ src dst ts idA idB ipkA ipkB mA nce mB #i #j #k #l.
    ((((((((((FrankedRequest( src, dst, ts, ipkA, ipkB, mA ) @ #i) ∧
             (DisplayCaller( dst, src, ts, idA, ipkA, ipkB, mA ) @ #j)) ∧
            (Answered( dst, src, ipkB, ipkA, nce, mB ) @ #k)) ∧
           (DisplayRecipient( src, dst, idB, ipkB, ipkA, nce, mB ) @ #l)) ∧
          (¬(ipkA = ipkB))) ∧
         (#i < #j)) ∧
        (#j < #k)) ∧
       (#k < #l)) ∧
      (¬(∃ x #r. Reveal( x ) @ #r))) ∧
     (¬(∃ x #r. RevealId( x ) @ #r))) ∧
    (¬(∃ kk #r. RevealState( kk ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ src dst ts idA idB ipkA ipkB mA nce mB #i #j #k #l.
  (FrankedRequest( src, dst, ts, ipkA, ipkB, mA ) @ #i) ∧
  (DisplayCaller( dst, src, ts, idA, ipkA, ipkB, mA ) @ #j) ∧
  (Answered( dst, src, ipkB, ipkA, nce, mB ) @ #k) ∧
  (DisplayRecipient( src, dst, idB, ipkB, ipkA, nce, mB ) @ #l)
 ∧
  (¬(ipkA = ipkB)) ∧
  (#i < #j) ∧
  (#j < #k) ∧
  (#k < #l) ∧
  (∀ x #r. (Reveal( x ) @ #r) ⇒ ⊥) ∧
  (∀ x #r. (RevealId( x ) @ #r) ⇒ ⊥) ∧
  (∀ kk #r. (RevealState( kk ) @ #r) ⇒ ⊥)"
*/
by sorry

