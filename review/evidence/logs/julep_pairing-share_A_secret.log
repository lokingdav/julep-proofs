lemma share_A_secret [reuse, use_induction]:
  all-traces
  "∀ A ipkB #i #j.
    ((SecretA( A, ipkB ) @ #i) ∧ (!KU( A ) @ #j)) ⇒
    (∃ #r. (Reveal( ipkB ) @ #r) ∧ (#r < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ A ipkB #i #j.
  (SecretA( A, ipkB ) @ #i) ∧ (!KU( A ) @ #j)
 ∧
  ∀ #r. (Reveal( ipkB ) @ #r) ⇒ ¬(#r < #j)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (∃ #j. (!KU( z ) @ #j) ∧ #j < #i)  ∥
         (∃ #j. (SendB( z ) @ #j) ∧ #j < #i) )
    case case_1
    solve( (∃ #j.
             (ResponseSent( z, <'phi', piB, $dst, <vkaB, vkbB, pkcB>, 'ex', 'nodlg'>,
                            <vkaB, vkbB, pkcB>
              ) @ #j)
            ∧
             #j < #i)  ∥
           (∃ #j. (!KU( z ) @ #j) ∧ #j < #i) )
      case case_1
      solve( ResponseSent( z,
                           <'phi', piB, $dst, <vkaB, vkbB, pkcB>, 'ex', 'nodlg'>, <vkaB, vkbB, pkcB>
             ) @ #j.1 )
        case Pair_B1_delegated
        solve( (last(#j.2))  ∥ (last(#i))  ∥
               (∃ #r.
                 (Reveal( <vkaB, vkbB, pkcB> ) @ #r) ∧ (¬(last(#r))) ∧ (#r < #j.2)) )
          case case_1
          solve( !KU( 'g'^~a ) @ #j.2 )
            case Pair_A2_case_1
            by contradiction /* from formulas */
          next
            case Pair_A2_case_2
            solve( (∃ #j. (!KU( 'g'^~a ) @ #j) ∧ #j < #vr)  ∥
                   (∃ #j. (SendB( 'g'^~a ) @ #j) ∧ #j < #vr) )
              case case_1
              by contradiction /* cyclic */
            next
              case case_2
              solve( (∃ #j.
                       (ResponseSent( 'g'^~a,
                                      <'phi', piB.1, $dst.1, <vkaB.1, vkbB.1, pk(x)>, 'ex', 'nodlg'>,
                                      <vkaB.1, vkbB.1, pk(x)>
                        ) @ #j)
                      ∧
                       #j < #vr)  ∥
                     (∃ #j. (!KU( 'g'^~a ) @ #j) ∧ #j < #vr) )
                case case_1
                by solve( SendB( 'g'^~a ) @ #j.3 )
              next
                case case_2
                by contradiction /* cyclic */
              qed
            qed
          next
            case Pair_A2_case_3
            solve( (∃ #j. (!KU( 'g'^(~a*x) ) @ #j) ∧ #j < #vr)  ∥
                   (∃ #j. (SendB( 'g'^(~a*x) ) @ #j) ∧ #j < #vr) )
              case case_1
              by contradiction /* cyclic */
            next
              case case_2
              solve( (∃ #j.
                       (ResponseSent( 'g'^(~a*x.1),
                                      <'phi', piB.1, $dst.1, <vkaB.1, vkbB.1, pk(x)>, 'ex', 'nodlg'>,
                                      <vkaB.1, vkbB.1, pk(x)>
                        ) @ #j)
                      ∧
                       #j < #vr)  ∥
                     (∃ #j. (!KU( 'g'^(~a*x.1) ) @ #j) ∧ #j < #vr) )
                case case_1
                by solve( SendB( 'g'^(~a*x.1) ) @ #j.3 )
              next
                case case_2
                by contradiction /* cyclic */
              qed
            qed
          next
            case Pair_A2_case_4
            solve( (∃ #j. (!KU( 'g'^(~a*inv(x)) ) @ #j) ∧ #j < #vr)  ∥
                   (∃ #j. (SendB( 'g'^(~a*inv(x)) ) @ #j) ∧ #j < #vr) )
              case case_1
              by contradiction /* cyclic */
            next
              case case_2
              solve( (∃ #j.
                       (ResponseSent( 'g'^(~a*inv(x.1)),
                                      <'phi', piB.1, $dst.1, <vkaB.1, vkbB.1, pk(x)>, 'ex', 'nodlg'>,
                                      <vkaB.1, vkbB.1, pk(x)>
                        ) @ #j)
                      ∧
                       #j < #vr)  ∥
                     (∃ #j. (!KU( 'g'^(~a*inv(x.1)) ) @ #j) ∧ #j < #vr) )
                case case_1
                by solve( SendB( 'g'^(~a*inv(x.1)) ) @ #j.3 )
              next
                case case_2
                by contradiction /* cyclic */
              qed
            qed
          next
            case Pair_A2_case_5
            solve( (∃ #j. (!KU( 'g'^(~a*x*inv(x.1)) ) @ #j) ∧ #j < #vr)  ∥
