            case Pair_A2_case_1
            by contradiction /* from formulas */
          next
            case Pair_A2_case_2
            solve( (∃ #j. (!KU( 'g'^~a ) @ #j) ∧ #j < #vr)  ∥
                   (∃ #j. (SendB( 'g'^~a ) @ #j) ∧ #j < #vr) )
              case case_1
