lemma dh_exponents_secret [reuse]:
  all-traces "∀ x #i. (DhExp( x ) @ #i) ⇒ (¬(∃ #j. !KU( x ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (DhExp( x ) @ #i) ∧ ∃ #j. (!KU( x ) @ #j)"
*/
by sorry

lemma decryption_key_secret [reuse, use_induction]:
  all-traces
  "∀ ipk sk #i #j.
    ((DecryptionKey( ipk, sk ) @ #i) ∧ (!KU( sk ) @ #j)) ⇒
    (∃ #r. (Reveal( ipk ) @ #r) ∧ (#r < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ ipk sk #i #j.
  (DecryptionKey( ipk, sk ) @ #i) ∧ (!KU( sk ) @ #j)
 ∧
  ∀ #r. (Reveal( ipk ) @ #r) ⇒ ¬(#r < #j)"
*/
by sorry

lemma hidden_proof_secret [reuse, use_induction]:
  all-traces
  "∀ pi ipkA ipkB tn id #i #j #e.
    (((HiddenProof( pi, ipkA, ipkB ) @ #i) ∧
      (Enrolled( tn, ipkA, id ) @ #e)) ∧
     (!KU( pi ) @ #j)) ⇒
    ((∃ #r. (Reveal( ipkA ) @ #r) ∧ (#r < #j)) ∨
     (∃ #r. (Reveal( ipkB ) @ #r) ∧ (#r < #j)))"
/*
guarded formula characterizing all counter-examples:
"∃ pi ipkA ipkB tn id #i #j #e.
  (HiddenProof( pi, ipkA, ipkB ) @ #i) ∧
  (Enrolled( tn, ipkA, id ) @ #e) ∧
  (!KU( pi ) @ #j)
 ∧
  (∀ #r. (Reveal( ipkA ) @ #r) ⇒ ¬(#r < #j)) ∧
  (∀ #r. (Reveal( ipkB ) @ #r) ⇒ ¬(#r < #j))"
*/
by sorry

lemma received_share_origin [reuse, use_induction]:
  all-traces
  "∀ B #i.
    (RecvB( B ) @ #i) ⇒
    ((∃ #j. (!KU( B ) @ #j) ∧ (#j < #i)) ∨
     (∃ #j. (SendB( B ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ B #i.
  (RecvB( B ) @ #i)
 ∧
  (∀ #j. (!KU( B ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #j. (SendB( B ) @ #j) ⇒ ¬(#j < #i))"
*/
by sorry

lemma response_binding [reuse, use_induction]:
  all-traces
  "∀ B phiB ipkB #i.
    (ResponseReceived( B, phiB, ipkB ) @ #i) ⇒
    ((∃ #j. (ResponseSent( B, phiB, ipkB ) @ #j) ∧ (#j < #i)) ∨
     (∃ #j. (!KU( B ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ B phiB ipkB #i.
  (ResponseReceived( B, phiB, ipkB ) @ #i)
 ∧
  (∀ #j. (ResponseSent( B, phiB, ipkB ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #j. (!KU( B ) @ #j) ⇒ ¬(#j < #i))"
*/
by sorry

