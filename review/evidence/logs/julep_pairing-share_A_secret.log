                       (ResponseSent( 'g'^~a,
                                      <'phi', piB.1, $dst.1, <vkaB.1, vkbB.1, pk(x)>, 'ex', 'nodlg'>,
                                      <vkaB.1, vkbB.1, pk(x)>
                        ) @ #j)
                      ∧
                       #j < #vr)  ∥
                     (∃ #j. (!KU( 'g'^~a ) @ #j) ∧ #j < #vr) )
                case case_1
