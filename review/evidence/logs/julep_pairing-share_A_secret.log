rule (modulo E) Pair_B2:
   [
   StB1( $dst, $src, $ts, idx, phiA, phiB, ~b, ipkAstar, ipkB )[no_precomp],
   !LtkK( ipkB, ~ska, ~skb, ~skc )[no_precomp],
