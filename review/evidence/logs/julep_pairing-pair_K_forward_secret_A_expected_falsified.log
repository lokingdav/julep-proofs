lemma executable_delegated_full:
  exists-trace
  "∃ src dst ts K ipkO ipkD ipkB #i #j #k #l.
    (((((((PairStartDelegated( src, ipkO, ipkD ) @ #i) ∧
          (AcceptedDelegation( dst, src, ipkO, ipkD ) @ #j)) ∧
         (PairedA( src, dst, ts, K, ipkD, ipkB ) @ #k)) ∧
        (PairedB( dst, src, ts, K, ipkB, ipkD ) @ #l)) ∧
       (¬(ipkO = ipkD))) ∧
      (¬(ipkD = ipkB))) ∧
     (¬(ipkO = ipkB))) ∧
    (¬(∃ x #r. Reveal( x ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
