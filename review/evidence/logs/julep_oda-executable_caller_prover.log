lemma ltk_secret [reuse]:
  all-traces
  "∀ ipk ska skb skc #i.
    (LtkGen( ipk, ska, skb, skc ) @ #i) ⇒
    ((((¬(∃ #k. !KU( ska ) @ #k)) ∧ (¬(∃ #k. !KU( skb ) @ #k))) ∧
      (¬(∃ #k. !KU( skc ) @ #k))) ∨
     (∃ #r. Reveal( ipk ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ ipk ska skb skc #i.
  (LtkGen( ipk, ska, skb, skc ) @ #i)
 ∧
  (((∃ #k. (!KU( ska ) @ #k)) ∨
    (∃ #k. (!KU( skb ) @ #k)) ∨
    (∃ #k. (!KU( skc ) @ #k)))) ∧
  (∀ #r. (Reveal( ipk ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma cred_sig_secret [reuse]:
  all-traces
  "∀ ipk pl attr csig #i.
    (CredIssued( ipk, pl, attr, csig ) @ #i) ⇒ (¬(∃ #k. !KU( csig ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ ipk pl attr csig #i.
  (CredIssued( ipk, pl, attr, csig ) @ #i) ∧ ∃ #k. (!KU( csig ) @ #k)"
*/
by sorry

lemma dh_exponents_secret [reuse]:
  all-traces "∀ x #i. (DhExp( x ) @ #i) ⇒ (¬(∃ #j. !KU( x ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (DhExp( x ) @ #i) ∧ ∃ #j. (!KU( x ) @ #j)"
*/
by sorry

lemma ltk_secret_ordered [reuse, use_induction]:
  all-traces
  "∀ ipk ska skb skc #i #k.
    ((LtkGen( ipk, ska, skb, skc ) @ #i) ∧ (!KU( ska ) @ #k)) ⇒
    (∃ #r. (Reveal( ipk ) @ #r) ∧ (#r < #k))"
/*
guarded formula characterizing all counter-examples:
"∃ ipk ska skb skc #i #k.
  (LtkGen( ipk, ska, skb, skc ) @ #i) ∧ (!KU( ska ) @ #k)
 ∧
  ∀ #r. (Reveal( ipk ) @ #r) ⇒ ¬(#r < #k)"
*/
by sorry

lemma authenticated_share_origin [reuse, hide_lemma=ltk_secret]:
  all-traces
  "∀ X ipkS ipkR #i.
    (AuthShare( X, ipkS, ipkR ) @ #i) ⇒
    (((∃ x #s. (FreshShare( X, x ) @ #s) ∧ (#s < #i)) ∨
      (∃ #r. (Reveal( ipkS ) @ #r) ∧ (#r < #i))) ∨
     (∃ #r. (Reveal( ipkR ) @ #r) ∧ (#r < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ X ipkS ipkR #i.
  (AuthShare( X, ipkS, ipkR ) @ #i)
 ∧
  (∀ x #s. (FreshShare( X, x ) @ #s) ⇒ ¬(#s < #i)) ∧
  (∀ #r. (Reveal( ipkS ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (Reveal( ipkR ) @ #r) ⇒ ¬(#r < #i))"
*/
by sorry

lemma dh_shared_secret [reuse]:
  all-traces
  "∀ z ipkX ipkY #i.
    (DhSecret( z, ipkX, ipkY ) @ #i) ⇒
    (((¬(∃ #j. !KU( z ) @ #j)) ∨ (∃ #r. (Reveal( ipkX ) @ #r) ∧ (#r < #i))) ∨
     (∃ #r. (Reveal( ipkY ) @ #r) ∧ (#r < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ z ipkX ipkY #i.
  (DhSecret( z, ipkX, ipkY ) @ #i)
 ∧
  (∃ #j. (!KU( z ) @ #j)) ∧
  (∀ #r. (Reveal( ipkX ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (Reveal( ipkY ) @ #r) ⇒ ¬(#r < #i))"
*/
by sorry

lemma derived_key_secret [reuse, hide_lemma=authenticated_share_origin]:
  all-traces
  "∀ k ipkX ipkY #i.
    (DerivedKey( k, ipkX, ipkY ) @ #i) ⇒
    ((((¬(∃ #j. !KU( k ) @ #j)) ∨
       (∃ #r. (Reveal( ipkX ) @ #r) ∧ (#r < #i))) ∨
      (∃ #r. (Reveal( ipkY ) @ #r) ∧ (#r < #i))) ∨
     (∃ x y #r. RevealState( k, x, y ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ k ipkX ipkY #i.
  (DerivedKey( k, ipkX, ipkY ) @ #i)
 ∧
  (∃ #j. (!KU( k ) @ #j)) ∧
  (∀ #r. (Reveal( ipkX ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (Reveal( ipkY ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ x y #r. (RevealState( k, x, y ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma callst_only_after_ca [reuse, use_induction, heuristic=S,
                            hide_lemma=dh_exponents_secret, hide_lemma=authenticated_share_origin,
                            hide_lemma=dh_shared_secret, hide_lemma=derived_key_secret]:
  all-traces
  "∀ role ipkS ipkO cdt #i.
    (CallState( role, ipkS, ipkO, cdt ) @ #i) ⇒
    (∃ #c. (CaDone( role, ipkS, ipkO, cdt ) @ #c) ∧ ((#c < #i) ∨ (#c = #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ role ipkS ipkO cdt #i.
  (CallState( role, ipkS, ipkO, cdt ) @ #i)
 ∧
  ∀ #c.
   (CaDone( role, ipkS, ipkO, cdt ) @ #c) ⇒ (¬(#c < #i)) ∧ (¬(#c = #i))"
*/
by sorry

