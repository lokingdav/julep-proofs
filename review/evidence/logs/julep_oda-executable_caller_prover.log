                                 hide_lemma=authenticated_share_origin, hide_lemma=dh_shared_secret,
                                 hide_lemma=derived_key_secret]:
  all-traces
  "∀ ipkA ipkB cdt #i.
    (CaDone( 'clr', ipkA, ipkB, cdt ) @ #i) ⇒
    (((∃ #a. (Answered( ipkB, ipkA, cdt ) @ #a) ∧ (#a < #i)) ∨
      (∃ #r. Reveal( ipkA ) @ #r)) ∨
     (∃ #r. Reveal( ipkB ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ ipkA ipkB cdt #i.
  (CaDone( 'clr', ipkA, ipkB, cdt ) @ #i)
 ∧
  (∀ #a. (Answered( ipkB, ipkA, cdt ) @ #a) ⇒ ¬(#a < #i)) ∧
  (∀ #r. (Reveal( ipkA ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( ipkB ) @ #r) ⇒ ⊥)"
*/
by sorry

