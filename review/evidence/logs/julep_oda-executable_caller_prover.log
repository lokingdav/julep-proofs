     Fr( ~rhoP ), Fr( ~proof_random ),
     !Ltk( $tnR, ipkR, kaPeer, kbPeer, kcPeer )[no_precomp]
     ]
    --[
    DhExp( ~b ), DhSecret( z, ipkP, ipkR ),
    DerivedKey( kdf(<'icv', kj, h(hidx), mR, sigR, 
                     <'4', h(<'nce', mR, sigR>), 'g'^~b, 'pres', 
