    DhExp( ~a ), DhSecret( z, ipkA, <pk(skaB), vkbB, pkcB> ),
    DerivedKey( kdf(<'ca', ~k, h(hidx), mA, sigA, 
                     <'2', h(<'nce', mA, sigA>), B>, sigB, z>),
                ipkA, <pk(skaB), vkbB, pkcB>
    ),
    CaDone( 'clr', ipkA, <pk(skaB), vkbB, pkcB>, cdt ),
    AuthShare( B, <pk(skaB), vkbB, pkcB>, ipkA ), RecvShare( B ),
    CallState( 'clr', ipkA, <pk(skaB), vkbB, pkcB>, cdt )
    ]->
     [
     CallSt( 'clr', $src, $dst, ipkA, <pk(skaB), vkbB, pkcB>, cdt, h(hidx),
             kdf(<'ca', ~k, h(hidx), mA, sigA, <'2', h(<'nce', mA, sigA>), B>, sigB, z
                 >)
     ),
     CurrentKey( 'clr',
                 kdf(<'ca', ~k, h(hidx), mA, sigA, <'2', h(<'nce', mA, sigA>), B>, sigB, z
                     >),
                 ipkA, <pk(skaB), vkbB, pkcB>, 'private'
     )
     ]
    variants (modulo AC)
    1. ~a    = ~a.35
       B     = B.37
       z     = B.37^~a.35
    
    2. ~a    = ~a.61
       B     = z.89^inv(~a.61)
       z     = z.89
    
    3. ~a    = ~a.244
       B     = x.483^x.484
       z     = x.483^(~a.244*x.484)
    
    4. ~a    = ~a.246
       B     = x.487^inv((~a.246*x.488))
       z     = x.487^inv(x.488)
    
    5. ~a    = ~a.246
       B     = x.487^(x.488*inv(~a.246))
       z     = x.487^x.488
    
    6. ~a    = ~a.247
       B     = x.488^(x.489*inv((~a.247*x.490)))
       z     = x.488^(x.489*inv(x.490))
    
    7. B     = DH_neutral
       z     = DH_neutral
  */

rule (modulo E) ICV_R1:
   [
   CallSt( role, $tnR, $tnP, ipkR, ipkP, <$cs, $cd, $cts>, h(hidx), kj
   )[no_precomp],
   !Ltk( $tnR, ipkR, ~skaR, ~skbR, ~skcR )[no_precomp], Fr( ~a ),
   Fr( ~sigR ), Fr( ~rhoR )
   ]
  --[
  DhExp( ~a ), IcvRequest( ipkR, ipkP, <$cs, $cd, $cts>, $pl ),
  SendShare( 'g'^~a ), FreshShare( 'g'^~a, ~a )
  ]->
   [
   IcvStR( role, $tnR, $tnP, ipkR, ipkP, <$cs, $cd, $cts>, h(hidx), kj, $pl,
           ~a,
           <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, $pl, 'g'^~a
           >,
           ~sigR,
           aead(<'icvreq', 
                 <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, $pl, 'g'^~a
                 >, 
                 ~sigR>,
                kj, ~rhoR, <h(hidx), 'icvreq', 'requester'>)
   ),
   !Amf( ~sigR,
         <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, $pl, 'g'^~a
         >,
         pk(~skaR), ipkP, 'mvk'
   ),
   Out( <h(hidx), 
         aead(<'icvreq', 
               <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, $pl, 'g'^~a
               >, 
               ~sigR>,
              kj, ~rhoR, <h(hidx), 'icvreq', 'requester'>)
        >
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ICV_P1_accept:
   [
   CallSt( role, $tnP, $tnR, ipkP, <pk(skaR), vkbR, pkcR>, <$cs, $cd, $cts>,
           h(hidx), kj
   )[no_precomp],
   !Amf( sigR,
         <'3', h(<'ratchet-context', kj, h(hidx)>), <$cs, $cd, $cts>, pl, A>,
         pk(skaR), ipkP, 'mvk'
   )[no_precomp],
   In( <h(hidx), 
