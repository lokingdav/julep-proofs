lemma executable_two_rounds [hide_lemma=ltk_secret,
                             hide_lemma=cred_sig_secret, hide_lemma=dh_exponents_secret,
                             hide_lemma=authenticated_share_origin, hide_lemma=dh_shared_secret,
                             hide_lemma=derived_key_secret, hide_lemma=callst_only_after_ca,
                             hide_lemma=ca_caller_requires_answer, hide_lemma=oda2_present_after_ca,
                             hide_lemma=oda2_recipient_present_after_answer,
                             hide_lemma=presentation_key_origin, hide_lemma=oda2_presentation_secret]:
  exists-trace
  "∃ ipkP ipkR cdt pl #ca #a #q1 #d1 #f1 #q2 #d2 #f2.
    (((((((((((((((((((((((CaRequest( ipkR, ipkP, cdt ) @ #ca) ∧
                          (Answered( ipkP, ipkR, cdt ) @ #a)) ∧
                         (IcvRequest( ipkR, ipkP, cdt, pl ) @ #q1)) ∧
                        (IcvDeclined( 'rcp', ipkP, ipkR, cdt, pl ) @ #d1)) ∧
                       (IcvComplete( ipkR, ipkP, cdt ) @ #f1)) ∧
                      (IcvRequest( ipkR, ipkP, cdt, pl ) @ #q2)) ∧
                     (IcvDeclined( 'rcp', ipkP, ipkR, cdt, pl ) @ #d2)) ∧
                    (IcvComplete( ipkR, ipkP, cdt ) @ #f2)) ∧
                   (¬(ipkP = ipkR))) ∧
                  (#ca < #a)) ∧
                 (#a < #q1)) ∧
                (#q1 < #d1)) ∧
               (#d1 < #f1)) ∧
              (#f1 < #q2)) ∧
             (#q2 < #d2)) ∧
            (#d2 < #f2)) ∧
           (∀ x y c #t. (CaRequest( x, y, c ) @ #t) ⇒ (#t = #ca))) ∧
          (∀ x y c #t. (Answered( x, y, c ) @ #t) ⇒ (#t = #a))) ∧
         (∀ x y c p #r.
           (IcvRequest( x, y, c, p ) @ #r) ⇒ ((#r = #q1) ∨ (#r = #q2)))) ∧
        (∀ ro x y c p #r.
          (IcvDeclined( ro, x, y, c, p ) @ #r) ⇒ ((#r = #d1) ∨ (#r = #d2)))) ∧
       (∀ x y c #r.
         (IcvComplete( x, y, c ) @ #r) ⇒ ((#r = #f1) ∨ (#r = #f2)))) ∧
      (¬(∃ ro x y c p pr k #r. Present( ro, x, y, c, p, pr, k ) @ #r))) ∧
     (¬(∃ x #r. Reveal( x ) @ #r))) ∧
    (¬(∃ k x y #r. RevealState( k, x, y ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ ipkP ipkR cdt pl #ca #a #q1 #d1 #f1 #q2 #d2 #f2.
  (CaRequest( ipkR, ipkP, cdt ) @ #ca) ∧
  (Answered( ipkP, ipkR, cdt ) @ #a) ∧
  (IcvRequest( ipkR, ipkP, cdt, pl ) @ #q1) ∧
  (IcvDeclined( 'rcp', ipkP, ipkR, cdt, pl ) @ #d1) ∧
  (IcvComplete( ipkR, ipkP, cdt ) @ #f1) ∧
  (IcvRequest( ipkR, ipkP, cdt, pl ) @ #q2) ∧
  (IcvDeclined( 'rcp', ipkP, ipkR, cdt, pl ) @ #d2) ∧
  (IcvComplete( ipkR, ipkP, cdt ) @ #f2)
 ∧
  (¬(ipkP = ipkR)) ∧
  (#ca < #a) ∧
  (#a < #q1) ∧
  (#q1 < #d1) ∧
  (#d1 < #f1) ∧
  (#f1 < #q2) ∧
  (#q2 < #d2) ∧
  (#d2 < #f2) ∧
  (∀ x y c #t. (CaRequest( x, y, c ) @ #t) ⇒ #t = #ca) ∧
  (∀ x y c #t. (Answered( x, y, c ) @ #t) ⇒ #t = #a) ∧
  (∀ x y c p #r.
    (IcvRequest( x, y, c, p ) @ #r) ⇒ ((#r = #q1) ∨ (#r = #q2))) ∧
  (∀ ro x y c p #r.
    (IcvDeclined( ro, x, y, c, p ) @ #r) ⇒ ((#r = #d1) ∨ (#r = #d2))) ∧
  (∀ x y c #r. (IcvComplete( x, y, c ) @ #r) ⇒ ((#r = #f1) ∨ (#r = #f2))) ∧
  (∀ ro x y c p pr k #r. (Present( ro, x, y, c, p, pr, k ) @ #r) ⇒ ⊥) ∧
  (∀ x #r. (Reveal( x ) @ #r) ⇒ ⊥) ∧
  (∀ k x y #r. (RevealState( k, x, y ) @ #r) ⇒ ⊥)"
*/
simplify
solve( PairStA( $src, $dst, ipkR, <pk(skaP), vkbP, pkcP>, ~k
       )[no_precomp] ▶₀ #ca )
  case Inject_PairState
  solve( !Ltk( $src, <pk(~skaA), pk(~skbA), pk(~skcA)>, ~skaA.1, ~skbA.1,
               ~skcA.1
         )[no_precomp] ▶₁ #ca )
    case Enroll
    solve( CaStB( $dst.1, $src.1, <pk(~skaB), pk(~skbB), pk(~skcB)>,
                  <pk(~skaA), pk(~skbA), pk(~skcA)>, ~k.1, h(hidx.6), <$src, $dst, $ts>,
                  mA, sigA.1, ctxA, A.2
           )[no_precomp] ▶₀ #a.5 )
      case CA_B1_display
      solve( CurrentKey( 'rcp', ~k.1, <pk(~skaB), pk(~skbB), pk(~skcB)>,
                         <pk(~skaA), pk(~skbA), pk(~skcA)>, exposed.4
             )[no_precomp] ▶₁ #a.5 )
        case Inject_PairState
        solve( !Ltk( $dst, <pk(~skaB), pk(~skbB), pk(~skcB)>, ~skaB.1, ~skbB.1,
                     ~skcB.1
               )[no_precomp] ▶₂ #a.5 )
          case Enroll
          solve( !Ltk( $src, <pk(~skaA), pk(~skbA), pk(~skcA)>, kaPeer.2, kbPeer.2,
                       kcPeer.2
                 )[no_precomp] ▶₆ #a.5 )
            case Enroll
            solve( CallSt( role.2, $tnR.4, $tnP.4, <pk(~skaA), pk(~skbA), pk(~skcA)>,
                           <pk(~skaB), pk(~skbB), pk(~skcB)>, <$src, $dst, $ts>, h(hidx.4), kj.4
                   )[no_precomp] ▶₀ #q1 )
              case CA_A2
              solve( !Ltk( $src, <pk(~skaA), pk(~skbA), pk(~skcA)>, ~skaR, ~skbR, ~skcR
                     )[no_precomp] ▶₁ #q1 )
                case Enroll
                solve( IcvAsk( 'rcp', $tnP, $tnR, <pk(~skaB), pk(~skbB), pk(~skcB)>,
                               <pk(~skaA), pk(~skbA), pk(~skcA)>, <$src, $dst, $ts>, h(hidx), kj, $pl,
