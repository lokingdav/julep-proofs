                         ~proof_random), 
                     $attr, pl>, 
                    ~sigP, A^~b>),
               ipkP, ipkR, 'private'
   ),
   !Amf( ~sigP,
         <'4', h(<'nce', mR, sigR>), 'g'^~b, 'pres', 
