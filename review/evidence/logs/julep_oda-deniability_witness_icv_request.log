   CallSt( role, $tnP, $tnR, ipkP, ipkR, cdt, h(hidx),
           kdf(<'icv', kj, h(hidx), mR, sigR, 
                <'4', h(<'nce', mR, sigR>), 'g'^~b, 'pres', 
                 pok(csig, ipkP, h(<'chal', kj, h(<'nce', mR, sigR>), 'g'^~b>),
                     ~proof_random), 
                 $attr, pl>, 
                ~sigP, A^~b>)
   ),
   CurrentKey( role,
               kdf(<'icv', kj, h(hidx), mR, sigR, 
