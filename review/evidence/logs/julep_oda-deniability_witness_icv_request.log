   !Cred( ipkP, pl, $attr, csig )[no_precomp],
   !Ltk( $tnP, ipkP, ~skaP, ~skbP, ~skcP )[no_precomp], Fr( ~sigP ),
   Fr( ~rhoP ), Fr( ~proof_random ),
   !Ltk( $tnR, ipkR, kaPeer, kbPeer, kcPeer )[no_precomp]
   ]
  --[
  DhExp( ~b ), DhSecret( A^~b, ipkP, ipkR ),
  DerivedKey( kdf(<'icv', kj, h(hidx), mR, sigR, 
                   <'4', h(<'nce', mR, sigR>), 'g'^~b, 'pres', 
                    pok(csig, ipkP, h(<'chal', kj, h(<'nce', mR, sigR>), 'g'^~b>),
                        ~proof_random), 
                    $attr, pl>, 
                   ~sigP, A^~b>),
