              ~proof_random), 
          $attr, pl>,
         pk(~skaP), ipkR, 'mvk'
   ),
   Out( <h(hidx), 
         aead(<'icvrsp', 
               <'4', h(<'nce', mR, sigR>), 'g'^~b, 'pres', 
                pok(csig, ipkP, h(<'chal', kj, h(<'nce', mR, sigR>), 'g'^~b>),
                    ~proof_random), 
                $attr, pl>, 
               ~sigP>,
              kj, ~rhoP, <h(hidx), 'icvrsp', 'prover'>)
        >
   )
   ]

  /*
  rule (modulo AC) ICV_P3_present:
     [
     IcvAskOk( role, $tnP, $tnR, ipkP, ipkR, cdt, h(hidx), kj, pl, ~b, mR,
               sigR, A, ctxR
     )[no_precomp],
