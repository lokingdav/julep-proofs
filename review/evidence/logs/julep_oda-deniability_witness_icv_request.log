    (((∃ x #s. (FreshShare( X, x ) @ #s) ∧ (#s < #i)) ∨
      (∃ #r. (Reveal( ipkS ) @ #r) ∧ (#r < #i))) ∨
     (∃ #r. (Reveal( ipkR ) @ #r) ∧ (#r < #i)))"
