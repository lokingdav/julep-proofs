           <'pres', 
            pok(csig, ipkP, h(<'chal', kj, h(<'nce', mR, sigR>), 'g'^~b>),
                ~proof_random), 
            $attr, pl>,
           kj
  ),
  SendShare( 'g'^~b ), FreshShare( 'g'^~b, ~b ),
