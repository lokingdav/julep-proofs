lemma pair_K_forward_secret_A_genuine:
  all-traces
  "∀ src dst ts kk ipkA ipkB B phiB #i #j.
    ((((PairedA( src, dst, ts, kk, ipkA, ipkB ) @ #i) ∧
       (ResponseReceived( B, phiB, ipkB ) @ #i)) ∧
      (ResponseSent( B, phiB, ipkB ) @ #j)) ∧
     (#j < #i)) ⇒
    (((¬(∃ #k. !KU( kk ) @ #k)) ∨
      (∃ #r. (Reveal( ipkA ) @ #r) ∧ (#r < #i))) ∨
     (∃ #r. (Reveal( ipkB ) @ #r) ∧ (#r < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ src dst ts kk ipkA ipkB B phiB #i #j.
  (PairedA( src, dst, ts, kk, ipkA, ipkB ) @ #i) ∧
  (ResponseReceived( B, phiB, ipkB ) @ #i) ∧
  (ResponseSent( B, phiB, ipkB ) @ #j)
 ∧
  (#j < #i) ∧
  (∃ #k. (!KU( kk ) @ #k)) ∧
  (∀ #r. (Reveal( ipkA ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (Reveal( ipkB ) @ #r) ⇒ ¬(#r < #i))"
*/
simplify
solve( ResponseSent( B,
                     <'phi', piB, $dst, <vkaB, vkbB, pkcB>, 'ex', 'nodlg'>, <vkaB, vkbB, pkcB>
       ) @ #j )
  case Pair_B1_delegated
  solve( (∃ #j.
           (ResponseSent( 'g'^~b,
                          <'phi', ~piB, $dst, <vkaB, vkbB, pkcB>, 'ex', 'nodlg'>,
                          <vkaB, vkbB, pkcB>
            ) @ #j)
          ∧
           #j < #i)  ∥
         (∃ #j. (!KU( 'g'^~b ) @ #j) ∧ #j < #i) )
    case case_1
    solve( (∃ #j. (!KU( 'g'^~b ) @ #j) ∧ #j < #i)  ∥
           (∃ #j. (SendB( 'g'^~b ) @ #j) ∧ #j < #i) )
      case case_1
      solve( ResponseSent( 'g'^~b,
                           <'phi', ~piB, $dst, <vkaB, vkbB, pkcB>, 'ex', 'nodlg'>,
                           <vkaB, vkbB, pkcB>
             ) @ #j.1 )
        case Pair_B1_delegated
        solve( !KU( 'g'^~b ) @ #j.1 )
          case Pair_A2_case_1
          solve( (∃ #j. (!KU( 'g'^~b ) @ #j) ∧ #j < #vr)  ∥
                 (∃ #j. (SendB( 'g'^~b ) @ #j) ∧ #j < #vr) )
            case case_1
            by contradiction /* cyclic */
          next
            case case_2
            solve( (∃ #j.
                     (ResponseSent( 'g'^~b,
                                    <'phi', piB.1, $dst.1, <vkaB.1, vkbB.1, pk(x)>, 'ex', 'nodlg'>,
                                    <vkaB.1, vkbB.1, pk(x)>
                      ) @ #j)
                    ∧
                     #j < #vr)  ∥
                   (∃ #j. (!KU( 'g'^~b ) @ #j) ∧ #j < #vr) )
              case case_1
              solve( SendB( 'g'^~b ) @ #j.2 )
                case Pair_B1_delegated
                solve( ResponseSent( 'g'^~b,
                                     <'phi', piB.1, $dst.1, <vkaB.1, vkbB.1, pk(x)>, 'ex', 'nodlg'>,
                                     <vkaB.1, vkbB.1, pk(x)>
                       ) @ #j.2 )
                  case Pair_B1_delegated
                  by contradiction /* from formulas */
                qed
              qed
            next
              case case_2
              by contradiction /* cyclic */
            qed
          qed
        next
          case Pair_A2_case_2
          solve( (∃ #j. (!KU( 'g'^(~b*x) ) @ #j) ∧ #j < #vr)  ∥
                 (∃ #j. (SendB( 'g'^(~b*x) ) @ #j) ∧ #j < #vr) )
            case case_1
            by contradiction /* cyclic */
          next
            case case_2
            solve( (∃ #j.
                     (ResponseSent( 'g'^(~b*x.1),
                                    <'phi', piB.1, $dst.1, <vkaB.1, vkbB.1, pk(x)>, 'ex', 'nodlg'>,
                                    <vkaB.1, vkbB.1, pk(x)>
                      ) @ #j)
                    ∧
                     #j < #vr)  ∥
                   (∃ #j. (!KU( 'g'^(~b*x.1) ) @ #j) ∧ #j < #vr) )
              case case_1
              by solve( SendB( 'g'^(~b*x.1) ) @ #j.2 )
            next
              case case_2
              by contradiction /* cyclic */
            qed
          qed
        next
          case Pair_A2_case_3
          solve( (∃ #j. (!KU( 'g'^(~b*inv(x)) ) @ #j) ∧ #j < #vr)  ∥
                 (∃ #j. (SendB( 'g'^(~b*inv(x)) ) @ #j) ∧ #j < #vr) )
            case case_1
            by contradiction /* cyclic */
          next
            case case_2
            solve( (∃ #j.
                     (ResponseSent( 'g'^(~b*inv(x.1)),
                                    <'phi', piB.1, $dst.1, <vkaB.1, vkbB.1, pk(x)>, 'ex', 'nodlg'>,
                                    <vkaB.1, vkbB.1, pk(x)>
                      ) @ #j)
                    ∧
                     #j < #vr)  ∥
                   (∃ #j. (!KU( 'g'^(~b*inv(x.1)) ) @ #j) ∧ #j < #vr) )
              case case_1
              by solve( SendB( 'g'^(~b*inv(x.1)) ) @ #j.2 )
            next
              case case_2
              by contradiction /* cyclic */
            qed
          qed
