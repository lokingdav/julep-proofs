 ∧
  (¬(#i1 = #i2)) ∧
  (∀ #r. (Reveal( ipkA ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( ipkB ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma pair_agreement_A_expected_falsified:
  all-traces
  "∀ src dst ts kk ipkA ipkB #i.
    (PairedA( src, dst, ts, kk, ipkA, ipkB ) @ #i) ⇒
    (((∃ B #j. (PairRespB( dst, src, ts, ipkB, ipkA, B ) @ #j) ∧ (#j < #i)) ∨
      (∃ #r. Reveal( ipkA ) @ #r)) ∨
     (∃ #r. Reveal( ipkB ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ src dst ts kk ipkA ipkB #i.
  (PairedA( src, dst, ts, kk, ipkA, ipkB ) @ #i)
 ∧
  (∀ B #j. (PairRespB( dst, src, ts, ipkB, ipkA, B ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #r. (Reveal( ipkA ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( ipkB ) @ #r) ⇒ ⊥)"
*/
simplify
solve( (∃ #j. (!KU( z ) @ #j) ∧ #j < #i)  ∥
       (∃ #j. (SendB( z ) @ #j) ∧ #j < #i) )
  case case_1
  solve( (∃ #j.
           (ResponseSent( z, <'phi', piB, $dst, <vkaB, vkbB, pkcB>, 'ex', 'nodlg'>,
                          <vkaB, vkbB, pkcB>
            ) @ #j)
          ∧
           #j < #i)  ∥
         (∃ #j. (!KU( z ) @ #j) ∧ #j < #i) )
    case case_2
    solve( !Proof( piB, $dst, <vkaB, vkbB, pkcB>, hidB,
                   h(<'n1', phiA, z, h(<'n0', h(<'idx0', $src, $ts>)>)>)
           )[no_precomp] ▶₂ #i )
      case Adversary_Prove_Token
      solve( StA1( $src, $dst, $ts, ipkA, h(<'idx0', $src, $ts>), phiA
             )[no_precomp] ▶₀ #i )
        case Pair_A1_delegated
        solve( !LtkK( <pk(~skaD), pk(~skbD), pk(~skcD)>, ~ska, ~skb, ~skc
               )[no_precomp] ▶₁ #i )
          case Enroll
          solve( splitEqs(0) )
            case split_case_1
            solve( !KU( h(<'idx0', $src, $ts>) )[no_precomp] @ #vk.1 )
              case c_h
              solve( !KU( aenc(<'rsp', 
                                <'phi', ~pi, $dst, <pk(~ska.1), pk(~skb.1), pk(~skc.1)>, 'ex', 'nodlg'>, 
                                'g'>,
                               pk(~skc))
                     )[no_precomp] @ #vk.2 )
                case c_aenc
                solve( !KU( ~pi ) @ #vk.20 )
                  case Adversary_Prove_Token
                  solve( !KU( sign(<'etk', $dst, <pk(~ska.1), pk(~skb.1), pk(~skc.1)>, 
                                    'ex', h(<'hid', ~id, pk(~ska.1), pk(~skb.1), pk(~skc.1)>)>,
                                   ~skES)
                         )[no_precomp] @ #vk.7 )
                    case Delegate
                    solve( !KU( h(<'hid', ~id, pk(~ska.1), pk(~skb.1), pk(~skc.1)>)
                           )[no_precomp] @ #vk.10 )
                      case Delegate
                      solve( !KU( h(<'n1', 
                                     <'phi', ~piA, $src, <pk(~skaO), pk(~skbO), pk(~skcO)>, 'ex', 'dlg', 
                                      'exD', <pk(~ska), pk(~skb), pk(~skc)>, 
                                      sign(<'dlg', <pk(~ska), pk(~skb), pk(~skc)>, 'exD', $src, 'orig'>,
                                           ~skbO)
                                     >, 
                                     'g', h(<'n0', h(<'idx0', $src, $ts>)>)>)
                             )[no_precomp] @ #vk.12 )
                        case c_h
                        solve( !KU( ~piA ) @ #vk.41 )
                          case Pair_A1_delegated
                          solve( !KU( pk(~skc) ) @ #vk.23 )
                            case Delegate_case_1
                            solve( !KU( pk(~ska.1) ) @ #vk.35 )
                              case Delegate_case_1
                              solve( !KU( pk(~skb.1) ) @ #vk.38 )
                                case Delegate
                                solve( !KU( pk(~skc.1) ) @ #vk.40 )
                                  case Delegate
                                  solve( !KU( pk(~skaO) ) @ #vk.48 )
                                    case Delegate_case_1
                                    solve( !KU( pk(~skbO) ) @ #vk.50 )
                                      case Delegate
                                      solve( !KU( pk(~skcO) ) @ #vk.51 )
                                        case Delegate
                                        solve( !KU( pk(~ska) ) @ #vk.54 )
                                          case Delegate
                                          solve( !KU( pk(~skb) ) @ #vk.55 )
                                            case Delegate
                                            solve( !KU( sign(<'dlg', <pk(~ska), pk(~skb), pk(~skc)>, 'exD', 
                                                              $src, 'orig'>,
                                                             ~skbO)
                                                   ) @ #vk.56 )
                                              case Delegate
                                              solve( !KU( h(<'n0', h(<'idx0', $src, $ts>)>) ) @ #vk.57 )
                                                case c_h
                                                SOLVED // trace found
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

