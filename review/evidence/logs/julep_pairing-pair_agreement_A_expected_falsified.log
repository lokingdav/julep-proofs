theory JulepPairing

begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman
functions: adec/2, aenc/2, fst/1, h/1, kdf/1, pair/2, pk/1, sign/2, snd/1
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: S

restriction OnlyOnce:
  "∀ x #i #j. ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i #j. ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  */

rule (modulo E) ES_Init:
   [ Fr( ~skES ) ]
  --[ OnlyOnce( 'ES' ) ]->
   [ !ES( ~skES ), Out( pk(~skES) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Enroll:
   [ !ES( ~skES )[no_precomp], Fr( ~ska ), Fr( ~skb ), Fr( ~skc ), Fr( ~id )
   ]
  --[
  Enrolled( $tn, <pk(~ska), pk(~skb), pk(~skc)>, ~id ),
  DecryptionKey( <pk(~ska), pk(~skb), pk(~skc)>, ~skc )
  ]->
   [
   !Ltk( $tn, <pk(~ska), pk(~skb), pk(~skc)>, ~ska, ~skb, ~skc ),
   !LtkK( <pk(~ska), pk(~skb), pk(~skc)>, ~ska, ~skb, ~skc ),
   !Etk( $tn, <pk(~ska), pk(~skb), pk(~skc)>, ~id,
         <$tn, <pk(~ska), pk(~skb), pk(~skc)>, 'ex', 
          h(<'hid', ~id, pk(~ska), pk(~skb), pk(~skc)>), 
          sign(<'etk', $tn, <pk(~ska), pk(~skb), pk(~skc)>, 'ex', 
                h(<'hid', ~id, pk(~ska), pk(~skb), pk(~skc)>)>,
               ~skES)
         >
   ),
   !Token( $tn, <pk(~ska), pk(~skb), pk(~skc)>,
           h(<'hid', ~id, pk(~ska), pk(~skb), pk(~skc)>),
           sign(<'etk', $tn, <pk(~ska), pk(~skb), pk(~skc)>, 'ex', 
                 h(<'hid', ~id, pk(~ska), pk(~skb), pk(~skc)>)>,
                ~skES)
   ),
   Out( <$tn, <pk(~ska), pk(~skb), pk(~skc)>, 'ex', 
         h(<'hid', ~id, pk(~ska), pk(~skb), pk(~skc)>), 
         sign(<'etk', $tn, <pk(~ska), pk(~skb), pk(~skc)>, 'ex', 
               h(<'hid', ~id, pk(~ska), pk(~skb), pk(~skc)>)>,
              ~skES)
        >
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Delegate:
   [
   !Ltk( $src, <pk(~skaO), pk(~skbO), pk(~skcO)>, ~skaO, ~skbO, ~skcO
   )[no_precomp],
   !Etk( $src, <pk(~skaO), pk(~skbO), pk(~skcO)>, ~idO, etkO )[no_precomp],
   !Etk( $tnD, ipkD, ~idD, etkD )[no_precomp]
   ]
  --[ Delegated( $src, <pk(~skaO), pk(~skbO), pk(~skcO)>, ipkD ) ]->
   [
   !Dtk( $src, <pk(~skaO), pk(~skbO), pk(~skcO)>, ipkD,
         <~idO, etkO, 'exD', ipkD, sign(<'dlg', ipkD, 'exD', $src, 'orig'>, ~skbO)
         >
   ),
   Out( <etkO, 'exD', ipkD, sign(<'dlg', ipkD, 'exD', $src, 'orig'>, ~skbO)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Ltk:
   [ !Ltk( $tn, ipk, ~ska, ~skb, ~skc )[no_precomp] ]
  --[ Reveal( ipk ) ]->
   [ Out( <~ska, ~skb, ~skc> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Adversary_Prove_Token:
   [
   !Token( tn, ipk, hid, sig )[no_precomp],
   In( <sig, hid, challenge> )[no_precomp], Fr( ~pi )
   ]
  -->
   [ !Proof( ~pi, tn, ipk, hid, challenge ), Out( ~pi ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Pair_A1_direct:
   [
   !Etk( $src, ipkA, ~idA, <$src, ipkA, 'ex', hidA, esigA> )[no_precomp],
   Fr( ~piA )
   ]
  --[ PairStartA( $src, $dst, $ts, ipkA ) ]->
   [
   StA1( $src, $dst, $ts, ipkA, h(<'idx0', $src, $ts>),
         <'phi', ~piA, $src, ipkA, 'ex', 'nodlg'>
   ),
   !Proof( ~piA, $src, ipkA, hidA, h(<'n0', h(<'idx0', $src, $ts>)>) ),
   Out( <h(<'idx0', $src, $ts>), 'phi', ~piA, $src, ipkA, 'ex', 'nodlg'> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Pair_A1_delegated:
   [
   !Dtk( $src, ipkO, ipkD,
         <~idO, <$src, ipkO, 'ex', hidO, esigO>, 'exD', ipkD, dsig>
   )[no_precomp],
   !Etk( $src, ipkO, ~idO, <$src, ipkO, 'ex', hidO, esigO> )[no_precomp],
   !LtkK( ipkD, ~skaD, ~skbD, ~skcD )[no_precomp], Fr( ~piA )
   ]
  --[
  PairStartA( $src, $dst, $ts, ipkD ),
  PairStartDelegated( $src, ipkO, ipkD )
  ]->
   [
   StA1( $src, $dst, $ts, ipkD, h(<'idx0', $src, $ts>),
         <'phi', ~piA, $src, ipkO, 'ex', 'dlg', 'exD', ipkD, dsig>
   ),
   !Proof( ~piA, $src, ipkO, hidO, h(<'n0', h(<'idx0', $src, $ts>)>) ),
   Out( <h(<'idx0', $src, $ts>), 'phi', ~piA, $src, ipkO, 'ex', 'dlg', 
         'exD', ipkD, dsig>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Pair_B1_direct:
   [
   !Etk( $dst, ipkB, ~idB, <$dst, ipkB, 'ex', hidB, esigB> )[no_precomp],
   !Proof( piA, $src, <vkaA, vkbA, pkcA>, hidA,
           h(<'n0', h(<'idx0', $src, $ts>)>)
   )[no_precomp],
   In( <h(<'idx0', $src, $ts>), 'phi', piA, $src, <vkaA, vkbA, pkcA>, 'ex', 
        'nodlg'>
   )[no_precomp],
   Fr( ~b ), Fr( ~piB )
   ]
  --[
  HiddenShare( 'g'^~b, <vkaA, vkbA, pkcA>, ipkB ),
  ResponseSent( 'g'^~b, <'phi', ~piB, $dst, ipkB, 'ex', 'nodlg'>, ipkB ),
  HiddenProof( ~piB, <vkaA, vkbA, pkcA>, ipkB ), SendB( 'g'^~b ),
  PairRespB( $dst, $src, $ts, ipkB, <vkaA, vkbA, pkcA>, 'g'^~b ),
  AcceptedCallerKey( $dst, $src, <vkaA, vkbA, pkcA> ), DhExp( ~b )
  ]->
   [
   StB1( $dst, $src, $ts, h(<'idx0', $src, $ts>),
         <'phi', piA, $src, <vkaA, vkbA, pkcA>, 'ex', 'nodlg'>,
         <'phi', ~piB, $dst, ipkB, 'ex', 'nodlg'>, ~b, <vkaA, vkbA, pkcA>, ipkB
   ),
   !Proof( ~piB, $dst, ipkB, hidB,
           h(<'n1', <'phi', piA, $src, <vkaA, vkbA, pkcA>, 'ex', 'nodlg'>, 'g'^~b, 
              h(<'n0', h(<'idx0', $src, $ts>)>)>)
   ),
   Out( <h(<'idx0', $src, $ts>), 
         aenc(<'rsp', <'phi', ~piB, $dst, ipkB, 'ex', 'nodlg'>, 'g'^~b>, pkcA)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Pair_B1_delegated:
   [
   !Etk( $dst, ipkB, ~idB, <$dst, ipkB, 'ex', hidB, esigB> )[no_precomp],
   !Proof( piA, $src, <vkaO, pk(skbO), pkcO>, hidO,
           h(<'n0', h(<'idx0', $src, $ts>)>)
   )[no_precomp],
   In( <h(<'idx0', $src, $ts>), 'phi', piA, $src, <vkaO, pk(skbO), pkcO>, 
        'ex', 'dlg', 'exD', <vkaD, vkbD, pkcD>, 
        sign(<'dlg', <vkaD, vkbD, pkcD>, 'exD', $src, 'orig'>, skbO)>
   )[no_precomp],
   Fr( ~b ), Fr( ~piB )
   ]
  --[
  HiddenShare( 'g'^~b, <vkaD, vkbD, pkcD>, ipkB ),
  ResponseSent( 'g'^~b, <'phi', ~piB, $dst, ipkB, 'ex', 'nodlg'>, ipkB ),
  HiddenProof( ~piB, <vkaD, vkbD, pkcD>, ipkB ), SendB( 'g'^~b ),
  PairRespB( $dst, $src, $ts, ipkB, <vkaD, vkbD, pkcD>, 'g'^~b ),
  AcceptedCallerKey( $dst, $src, <vkaD, vkbD, pkcD> ),
  AcceptedDelegation( $dst, $src, <vkaO, pk(skbO), pkcO>,
                      <vkaD, vkbD, pkcD>
  ),
  DhExp( ~b )
  ]->
   [
   StB1( $dst, $src, $ts, h(<'idx0', $src, $ts>),
         <'phi', piA, $src, <vkaO, pk(skbO), pkcO>, 'ex', 'dlg', 'exD', 
          <vkaD, vkbD, pkcD>, 
          sign(<'dlg', <vkaD, vkbD, pkcD>, 'exD', $src, 'orig'>, skbO)>,
         <'phi', ~piB, $dst, ipkB, 'ex', 'nodlg'>, ~b, <vkaD, vkbD, pkcD>, ipkB
   ),
   !Proof( ~piB, $dst, ipkB, hidB,
           h(<'n1', 
              <'phi', piA, $src, <vkaO, pk(skbO), pkcO>, 'ex', 'dlg', 'exD', 
               <vkaD, vkbD, pkcD>, 
               sign(<'dlg', <vkaD, vkbD, pkcD>, 'exD', $src, 'orig'>, skbO)>, 
              'g'^~b, h(<'n0', h(<'idx0', $src, $ts>)>)>)
   ),
   Out( <h(<'idx0', $src, $ts>), 
         aenc(<'rsp', <'phi', ~piB, $dst, ipkB, 'ex', 'nodlg'>, 'g'^~b>, pkcD)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Pair_A2:
   [
   StA1( $src, $dst, $ts, ipkA, h(<'idx0', $src, $ts>), phiA )[no_precomp],
   !LtkK( ipkA, ~ska, ~skb, ~skc )[no_precomp],
   !Proof( piB, $dst, <vkaB, vkbB, pkcB>, hidB,
           h(<'n1', phiA, 'g'^xb, h(<'n0', h(<'idx0', $src, $ts>)>)>)
   )[no_precomp],
   In( <h(<'idx0', $src, $ts>), 
        aenc(<'rsp', <'phi', piB, $dst, <vkaB, vkbB, pkcB>, 'ex', 'nodlg'>, 
              'g'^xb>,
             pk(~skc))
       >
   )[no_precomp],
   Fr( ~a )
   ]
  --[
  ResponseReceived( 'g'^xb,
                    <'phi', piB, $dst, <vkaB, vkbB, pkcB>, 'ex', 'nodlg'>, <vkaB, vkbB, pkcB>
  ),
  SecretA( 'g'^~a, <vkaB, vkbB, pkcB> ), RecvB( 'g'^xb ),
  PairedA( $src, $dst, $ts,
           kdf(<h(<'idx0', $src, $ts>), phiA, 
                <'phi', piB, $dst, <vkaB, vkbB, pkcB>, 'ex', 'nodlg'>, 'g'^~a, 'g'^xb, 
                'g'^xb^~a>),
           ipkA, <vkaB, vkbB, pkcB>
  ),
  AcceptedRecipientKey( $src, $dst, <vkaB, vkbB, pkcB> ), DhExp( ~a )
  ]->
   [
   PairStA( $src, $dst,
            kdf(<h(<'idx0', $src, $ts>), phiA, 
                 <'phi', piB, $dst, <vkaB, vkbB, pkcB>, 'ex', 'nodlg'>, 'g'^~a, 'g'^xb, 
                 'g'^xb^~a>),
            ipkA, <vkaB, vkbB, pkcB>
   ),
   Out( <h(<'idx0', $src, $ts>), aenc(<'fin', 'g'^~a, 'g'^xb>, pkcB)> )
   ]

  /*
  rule (modulo AC) Pair_A2:
     [
     StA1( $src, $dst, $ts, ipkA, h(<'idx0', $src, $ts>), phiA )[no_precomp],
     !LtkK( ipkA, ~ska, ~skb, ~skc )[no_precomp],
     !Proof( piB, $dst, <vkaB, vkbB, pkcB>, hidB,
             h(<'n1', phiA, z, h(<'n0', h(<'idx0', $src, $ts>)>)>)
     )[no_precomp],
     In( <h(<'idx0', $src, $ts>), 
          aenc(<'rsp', <'phi', piB, $dst, <vkaB, vkbB, pkcB>, 'ex', 'nodlg'>, z>,
               pk(~skc))
         >
     )[no_precomp],
     Fr( ~a )
     ]
    --[
    ResponseReceived( z,
                      <'phi', piB, $dst, <vkaB, vkbB, pkcB>, 'ex', 'nodlg'>, <vkaB, vkbB, pkcB>
    ),
    SecretA( 'g'^~a, <vkaB, vkbB, pkcB> ), RecvB( z ),
    PairedA( $src, $dst, $ts,
             kdf(<h(<'idx0', $src, $ts>), phiA, 
                  <'phi', piB, $dst, <vkaB, vkbB, pkcB>, 'ex', 'nodlg'>, 'g'^~a, z, 'g'^x
                 >),
             ipkA, <vkaB, vkbB, pkcB>
    ),
    AcceptedRecipientKey( $src, $dst, <vkaB, vkbB, pkcB> ), DhExp( ~a )
    ]->
     [
     PairStA( $src, $dst,
              kdf(<h(<'idx0', $src, $ts>), phiA, 
                   <'phi', piB, $dst, <vkaB, vkbB, pkcB>, 'ex', 'nodlg'>, 'g'^~a, z, 'g'^x
                  >),
              ipkA, <vkaB, vkbB, pkcB>
     ),
     Out( <h(<'idx0', $src, $ts>), aenc(<'fin', 'g'^~a, z>, pkcB)> )
     ]
    variants (modulo AC)
    1. ~a    = ~a.33
       x     = ~a.33
       z     = 'g'
    
    2. ~a    = ~a.387
       x     = (~a.387*xb.769)
       z     = 'g'^xb.769
  */

rule (modulo E) Pair_B2:
   [
   StB1( $dst, $src, $ts, idx, phiA, phiB, ~b, ipkAstar, ipkB )[no_precomp],
   !LtkK( ipkB, ~ska, ~skb, ~skc )[no_precomp],
   In( <idx, aenc(<'fin', 'g'^xa, 'g'^~b>, pk(~skc))> )[no_precomp]
   ]
  --[
  PairedB( $dst, $src, $ts,
           kdf(<idx, phiA, phiB, 'g'^xa, 'g'^~b, 'g'^xa^~b>), ipkB, ipkAstar
  )
  ]->
   [
   PairStB( $dst, $src, kdf(<idx, phiA, phiB, 'g'^xa, 'g'^~b, 'g'^xa^~b>),
            ipkB, ipkAstar
   )
   ]

  /*
  rule (modulo AC) Pair_B2:
     [
     StB1( $dst, $src, $ts, idx, phiA, phiB, ~b, ipkAstar, ipkB )[no_precomp],
     !LtkK( ipkB, ~ska, ~skb, ~skc )[no_precomp],
     In( <idx, aenc(<'fin', z, 'g'^~b>, pk(~skc))> )[no_precomp]
     ]
    --[
    PairedB( $dst, $src, $ts, kdf(<idx, phiA, phiB, z, 'g'^~b, z.1>), ipkB,
             ipkAstar
    )
    ]->
     [
     PairStB( $dst, $src, kdf(<idx, phiA, phiB, z, 'g'^~b, z.1>), ipkB,
              ipkAstar
     )
     ]
    variants (modulo AC)
    1. ~b    = ~b.19
       z     = 'g'
       z.1   = 'g'^~b.19
    
    2. ~b    = ~b.19
       z     = 'g'^inv(~b.19)
       z.1   = 'g'
    
    3. ~b    = ~b.85
       z     = 'g'^xa.165
       z.1   = 'g'^(~b.85*xa.165)
    
    4. ~b    = ~b.94
       z     = 'g'^inv((~b.94*x.183))
       z.1   = 'g'^inv(x.183)
    
    5. ~b    = ~b.94
       z     = 'g'^(x.183*inv(~b.94))
       z.1   = 'g'^x.183
    
    6. ~b    = ~b.95
       z     = 'g'^(x.184*inv((~b.95*x.185)))
       z.1   = 'g'^(x.184*inv(x.185))
  */

lemma dh_exponents_secret [reuse]:
  all-traces "∀ x #i. (DhExp( x ) @ #i) ⇒ (¬(∃ #j. !KU( x ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (DhExp( x ) @ #i) ∧ ∃ #j. (!KU( x ) @ #j)"
*/
by sorry

