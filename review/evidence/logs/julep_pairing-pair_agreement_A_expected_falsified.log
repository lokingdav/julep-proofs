lemma executable:
  exists-trace
  "∃ src dst ts K ipkA ipkB #i #j.
    (((PairedA( src, dst, ts, K, ipkA, ipkB ) @ #i) ∧
      (PairedB( dst, src, ts, K, ipkB, ipkA ) @ #j)) ∧
     (¬(ipkA = ipkB))) ∧
    (¬(∃ x #r. Reveal( x ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ src dst ts K ipkA ipkB #i #j.
  (PairedA( src, dst, ts, K, ipkA, ipkB ) @ #i) ∧
  (PairedB( dst, src, ts, K, ipkB, ipkA ) @ #j)
 ∧
  (¬(ipkA = ipkB)) ∧ (∀ x #r. (Reveal( x ) @ #r) ⇒ ⊥)"
*/
by sorry

