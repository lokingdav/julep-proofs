                                        <vkaB, vkbB, pk(~skc.2)>
                          ) @ #j)
                        ∧
                         #j < #vr.5)  ∥
                       (∃ #j. (!KU( 'g'^~b ) @ #j) ∧ #j < #vr.5) )
                  case case_1
                  solve( ResponseSent( 'g'^~b,
                                       <'phi', piB.1, $dst.1, <vkaB, vkbB, pk(~skc.2)>, 'ex', 'nodlg'>,
                                       <vkaB, vkbB, pk(~skc.2)>
                         ) @ #j.1 )
                    case Pair_B1_delegated
                    solve( (∃ #r.
                             (Reveal( <pk(~ska), pk(~skb), pk(~skc)> ) @ #r) ∧ #r < #j)  ∥
                           (∃ #r. (Reveal( <pk(~ska.2), pk(~skb.2), pk(~skc.2)> ) @ #r) ∧ #r < #j) )
                      case case_1
