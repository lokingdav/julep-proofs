  (∀ #r. (Reveal( ipkB ) @ #r) ⇒ ¬(#r < #i))"
*/
simplify
solve( StB1( $dst, $src, $ts, idx, phiA, phiB, ~b,
             <pk(~ska), pk(~skb), pk(~skc)>, ipkB
       )[no_precomp] ▶₀ #i )
  case Pair_B1_delegated
  solve( !LtkK( <pk(~ska.1), pk(~skb.1), pk(~skc.1)>, ~ska.2, ~skb.2,
                ~skc.2
         )[no_precomp] ▶₁ #i )
    case Enroll
    solve( !ES( ~skES )[no_precomp] ▶₀ #e )
      case ES_Init
      solve( !Proof( piA, $src, <vkaO, pk(skbO), pkcO>, hidO,
                     h(<'n0', h(<'idx0', $src, $ts>)>)
             )[no_precomp] ▶₁ #vr )
        case Adversary_Prove_Token
        solve( !KU( ~pi )[no_precomp] @ #vk.7 )
          case Adversary_Prove_Token
          solve( splitEqs(0) )
            case split_case_1
            solve( !KU( aenc(<'fin', 'g', 'g'^~b>, pk(~skc.2))
                   )[no_precomp] @ #vk.5 )
              case c_aenc
