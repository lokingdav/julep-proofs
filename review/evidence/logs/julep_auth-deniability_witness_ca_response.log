lemma amf_secret [reuse, use_induction]:
  all-traces
  "∀ ipk ska #i #j.
    ((AmfKey( ipk, ska ) @ #i) ∧ (!KU( ska ) @ #j)) ⇒
    (∃ #r. (Reveal( ipk ) @ #r) ∧ (#r < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ ipk ska #i #j.
  (AmfKey( ipk, ska ) @ #i) ∧ (!KU( ska ) @ #j)
 ∧
  ∀ #r. (Reveal( ipk ) @ #r) ⇒ ¬(#r < #j)"
*/
by sorry

lemma state_secret [reuse, use_induction]:
  all-traces
  "∀ kk src dst ipkA ipkB #i #j.
    ((SetupState( kk, src, dst, ipkA, ipkB ) @ #i) ∧ (!KU( kk ) @ #j)) ⇒
    (∃ #r. (RevealState( kk ) @ #r) ∧ (#r < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ kk src dst ipkA ipkB #i #j.
  (SetupState( kk, src, dst, ipkA, ipkB ) @ #i) ∧ (!KU( kk ) @ #j)
 ∧
  ∀ #r. (RevealState( kk ) @ #r) ⇒ ¬(#r < #j)"
*/
by sorry

lemma executable_direct:
  exists-trace
  "∃ src dst ts idA idB ipkA ipkB mA nce mB #i #j #k #l.
    ((((((((((FrankedRequest( src, dst, ts, ipkA, ipkB, mA ) @ #i) ∧
             (DisplayCaller( dst, src, ts, idA, ipkA, ipkB, mA ) @ #j)) ∧
            (Answered( dst, src, ipkB, ipkA, nce, mB ) @ #k)) ∧
           (DisplayRecipient( src, dst, idB, ipkB, ipkA, nce, mB ) @ #l)) ∧
          (¬(ipkA = ipkB))) ∧
         (#i < #j)) ∧
        (#j < #k)) ∧
       (#k < #l)) ∧
      (¬(∃ x #r. Reveal( x ) @ #r))) ∧
     (¬(∃ x #r. RevealId( x ) @ #r))) ∧
    (¬(∃ kk #r. RevealState( kk ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ src dst ts idA idB ipkA ipkB mA nce mB #i #j #k #l.
  (FrankedRequest( src, dst, ts, ipkA, ipkB, mA ) @ #i) ∧
  (DisplayCaller( dst, src, ts, idA, ipkA, ipkB, mA ) @ #j) ∧
  (Answered( dst, src, ipkB, ipkA, nce, mB ) @ #k) ∧
  (DisplayRecipient( src, dst, idB, ipkB, ipkA, nce, mB ) @ #l)
 ∧
  (¬(ipkA = ipkB)) ∧
  (#i < #j) ∧
  (#j < #k) ∧
  (#k < #l) ∧
  (∀ x #r. (Reveal( x ) @ #r) ⇒ ⊥) ∧
  (∀ x #r. (RevealId( x ) @ #r) ⇒ ⊥) ∧
  (∀ kk #r. (RevealState( kk ) @ #r) ⇒ ⊥)"
*/
by sorry

