         h(<'idxca', ~K, $src, $dst, $ts>),
         aead(<
               <'1', h(<'ratchet-context', ~K, h(<'idxca', ~K, $src, $dst, $ts>)>), 
                <$src, $dst, $ts>, $ts, A, ccx, idO, 
                <$src, <vkaO, pk(skbO), pkcO>, 'ex', 
                 h(<'hid', idO, vkaO, pk(skbO), pkcO>), esigO>, 
                'exD', <pk(skaD), vkbD, pkcD>, 
                sign(<'dlg', <pk(skaD), vkbD, pkcD>, 'exD', $src, 'orig'>, skbO)>, 
               sigA>,
              ~K, rhoA, <h(<'idxca', ~K, $src, $dst, $ts>), '1', 'caller'>),
         <'1', h(<'ratchet-context', ~K, h(<'idxca', ~K, $src, $dst, $ts>)>), 
          <$src, $dst, $ts>, $ts, A, ccx, idO, 
          <$src, <vkaO, pk(skbO), pkcO>, 'ex', 
           h(<'hid', idO, vkaO, pk(skbO), pkcO>), esigO>, 
          'exD', <pk(skaD), vkbD, pkcD>, 
          sign(<'dlg', <pk(skaD), vkbD, pkcD>, 'exD', $src, 'orig'>, skbO)>,
         sigA, A
   )
   ]

  /* has exactly the trivial AC variant */

